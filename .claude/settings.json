{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/shims/require-skill\" write-rbs 'sig/.*\\.rbs$|vendor/rbs/.*\\.rbs$'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
