# External OpenTelemetry types not available in RBS
module OpenTelemetry
  def self.meter_provider: () -> SDK::Metrics::MeterProvider?

  def self.meter_provider=: (SDK::Metrics::MeterProvider provider) -> void

  def self.logger_provider: () -> (SDK::Logs::LoggerProvider | Internal::ProxyLoggerProvider)

  def self.logger_provider=: (SDK::Logs::LoggerProvider | Internal::ProxyLoggerProvider provider) -> void

  module Internal
    class ProxyLoggerProvider
      def initialize: () -> void
    end
  end

  module SDK
    class Configurator
      attr_writer propagators: Array[untyped]?

      attr_writer id_generator: untyped

      def initialize: () -> void

      def configure: () -> void

      private

      def metrics_configuration_hook: () -> void

      def logs_configuration_hook: () -> void

      def wrapped_exporters_from_env: () -> Array[untyped]

      def configure_propagation: () -> void
    end

    module Trace
      class Event < Struct[untyped]
        attr_accessor name: String

        attr_accessor attributes: OpenTelemetry::Trace::attributes?

        attr_accessor timestamp: Integer
      end

      module Export
        SUCCESS: Integer

        FAILURE: Integer

        TIMEOUT: Integer
      end

      class Span < OpenTelemetry::Trace::Span
        attr_reader name: String

        attr_reader status: OpenTelemetry::Trace::Status

        attr_reader kind: Symbol

        attr_reader start_timestamp: Integer

        attr_reader end_timestamp: Integer?

        attr_reader links: Array[OpenTelemetry::Trace::Link]?

        def attributes: () -> OpenTelemetry::Trace::attributes?

        def events: () -> Array[Event]?
      end
    end

    module Resources
      class Resource
        def self.create: (::Hash[::String, untyped] attributes) -> untyped
      end
    end

    module Logs
      module ConfiguratorPatch
        def add_log_record_processor: (untyped log_record_processor) -> void

        private

        def logs_configuration_hook: () -> void
      end

      class LoggerProvider
        def initialize: (?resource: untyped) -> void

        def add_log_record_processor: (untyped processor) -> void

        def shutdown: () -> void

        def force_flush: () -> void

        def logger: (name: ::String, ?version: ::String?) -> untyped
      end

      class LogRecordData
      end

      module Export
        class BatchLogRecordProcessor
          def initialize: (
            untyped exporter,
            ?max_queue_size: ::Integer,
            ?schedule_delay: ::Integer,
            ?exporter_timeout: ::Integer,
            ?max_export_batch_size: ::Integer
          ) -> void
        end
      end
    end

    module Metrics
      module ConfiguratorPatch
        def add_metric_reader: (untyped metric_reader) -> void

        private

        def metrics_configuration_hook: () -> void
      end

      class MeterProvider
        def initialize: (?resource: untyped) -> void

        def add_metric_reader: (untyped reader) -> void

        def meter: (::String name, ?version: ::String?, ?schema_url: ::String?) -> Meter

        def shutdown: () -> void
      end

      class Meter
        def create_counter: (
          ::String name,
          ?unit: ::String?,
          ?description: ::String?
        ) -> Instrument::Counter
      end

      module Instrument
        class Counter
          def add: (::Integer | ::Float value, ?attributes: ::Hash[::String, untyped]) -> void
        end
      end

      module Export
        class PeriodicMetricReader
          def initialize: (exporter: untyped, export_interval_millis: ::Integer, export_timeout_millis: ::Integer) -> void
        end
      end
    end
  end

  module Common
    module Propagation
      class RackEnvGetter
        def get: (Hash[String, untyped] carrier, String key) -> String?

        def keys: (Hash[String, untyped] carrier) -> Array[String]
      end

      def self?.rack_env_getter: () -> RackEnvGetter
    end
  end

  module Exporter
    module OTLP
      module Metrics
        class MetricsExporter
          def initialize: (endpoint: ::String, timeout: ::Float, headers: ::Hash[untyped, untyped]) -> void
        end
      end

      module Logs
        class LogsExporter
          def initialize: (endpoint: ::String, timeout: ::Float, headers: ::Hash[untyped, untyped]) -> void

          def export: (::Array[SDK::Logs::LogRecordData] log_records, ?timeout: ::Float?) -> ::Integer
        end
      end
    end
  end
end

