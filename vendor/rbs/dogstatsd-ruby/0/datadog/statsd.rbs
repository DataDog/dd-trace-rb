module Datadog
  class Statsd
    VERSION: String

    def initialize: (
      ?String? host,
      ?Integer? port,
      ?socket_path: String?,
      ?namespace: String?,
      ?tags: Array[String] | Hash[String, String]?,
      ?sample_rate: Float?,
      ?buffer_max_payload_size: Integer?,
      ?buffer_max_pool_size: Integer?,
      ?buffer_overflowing_stategy: Symbol,
      ?buffer_flush_interval: Integer?,
      ?sender_queue_size: Integer?,
      ?logger: untyped?,
      ?single_thread: bool,
      ?delay_serialization: bool,
      ?telemetry_enable: bool,
      ?telemetry_flush_interval: Integer,
      ?origin_detection: bool,
      ?container_id: String?,
      ?cardinality: String?
    ) -> void

    def host: () -> String?

    def port: () -> Integer?

    def count: (String stat, Numeric value, ?Hash[Symbol, untyped] opts) -> void

    def gauge: (String stat, Numeric value, ?Hash[Symbol, untyped] opts) -> void

    def histogram: (String stat, Numeric value, ?Hash[Symbol, untyped] opts) -> void

    def distribution: (String stat, Numeric value, ?Hash[Symbol, untyped] opts) -> void

    def close: (?flush: bool) -> void

    def flush: (?flush_telemetry: bool, ?sync: bool) -> void
  end
end
