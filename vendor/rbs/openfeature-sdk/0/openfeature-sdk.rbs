module OpenFeature
  module SDK
    class EvaluationContext
      type fields_t = ::Hash[::String, untyped]

      TARGETING_KEY: ::String

      def targeting_key: () -> ::String?

      def fields: () -> fields_t

      def attributes: () -> fields_t
    end

    module Provider
      module EventEmitter
        @configuration: Configuration?

        def emit_event: (String event_type, ?Hash[Symbol, untyped] details) -> void

        def configuration_attached?: () -> bool
      end

      class ProviderMetadata
        def initialize: (name: ::String) -> void
      end

      class ResolutionDetails < ::Struct[untyped]
        type value_t = bool | ::String | ::Numeric | ::Integer | ::Float | ::Array[untyped] | ::Hash[untyped, untyped]

        def self.new: (
          ?value: value_t?,
          ?variant: untyped?,
          ?flag_metadata: ::Hash[untyped, untyped]?,
          ?error_code: ErrorCode::t?,
          ?error_message: ::String?,
          ?reason: Reason::t?
        ) -> instance
      end

      module ErrorCode
        type t = ::String

        PROVIDER_FATAL: t
      end

      module Reason
        type t = ::String

        ERROR: t
      end
    end

    module ProviderEvent
      PROVIDER_READY: String
      PROVIDER_ERROR: String
      PROVIDER_STALE: String
      PROVIDER_CONFIGURATION_CHANGED: String
    end

    module ProviderState
      ERROR: String
    end

    class Configuration
      def add_handler: (String event_type, ^(Hash[Symbol, untyped]) -> void handler) -> void

      def remove_handler: (String event_type, ^(Hash[Symbol, untyped]) -> void handler) -> void

      private

      def provider_state: (untyped provider) -> String
    end

    class EvaluationDetails < ::Struct[untyped]
      def variant: () -> ::String?
      def reason: () -> ::String?
      def error_code: () -> ::String?
      def error_message: () -> ::String?
      def value: () -> untyped
      def flag_metadata: () -> ::Hash[::String, untyped]?
    end

    module Hooks
      module Hook
      end

      class HookContext
        def flag_key: () -> ::String

        def evaluation_context: () -> EvaluationContext?
      end
    end
  end
end
