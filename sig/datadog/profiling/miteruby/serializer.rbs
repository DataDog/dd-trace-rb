module Datadog
  module Profiling
    module Miteruby
      class Serializer
        def initialize: () -> void

        def serialize: () -> [Time, Time, EncodedProfile, Hash[Symbol, Integer]]

        def serialize!: () -> EncodedProfile

        def reset_after_fork: () -> true

        def stats: () -> Hash[Symbol, Integer]

        def self._native_serialize: (Serializer serializer) -> [Time, Time, EncodedProfile, Hash[Symbol, Integer]]

        def self._native_reset_after_fork: (Serializer serializer) -> true

        def self._native_stats: (Serializer serializer) -> Hash[Symbol, Integer]
      end
    end
  end
end
