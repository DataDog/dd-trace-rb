module Datadog
  module Profiling
    module TagBuilder
      ALLOWED_TAGS: Set[String]

      FORM_FIELD_TAG_PROFILER_VERSION: "profiler_version"

      def self.call: (
        settings: untyped,
        ?profiler_version: ::String,
        profile_seq: ::Integer
      ) -> ::Hash[::String, ::String]
    end
  end
end
