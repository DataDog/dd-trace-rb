module Datadog
  module AIGuard
    module Evaluation
      class NoOpResult
        attr_reader action: Response::action
        attr_reader reason: Response::reason
        attr_reader tags: Response::tags
        attr_reader sds_findings: Response::sds_findings
        attr_reader tag_probabilities: Response::tag_probabilities
        attr_reader messages: Array[Message]

        def initialize: (Array[Message] messages) -> void

        def allow?: () -> bool

        def deny?: () -> bool

        def abort?: () -> bool

      end
    end
  end
end
