module Datadog
  module AIGuard
    module Evaluation
      class Result
        ALLOW_ACTION: ::String
        DENY_ACTION: ::String
        ABORT_ACTION: ::String

        attr_reader messages: Array[Message]
        attr_reader action: Response::action
        attr_reader reason: Response::reason
        attr_reader tags: Response::tags

        attr_reader sds_findings: Response::sds_findings
        attr_reader tag_probabilities: Response::tag_probabilities

        def initialize: (
          Array[Message] messages,
          action: Response::action,
          reason: Response::reason,
          tags: Response::tags,
          sds_findings: Response::sds_findings,
          tag_probabilities: Response::tag_probabilities
        ) -> void

        def allow?: () -> bool

        def deny?: () -> bool

        def abort?: () -> bool
      end
    end
  end
end
