module Datadog
  module AIGuard
    module Evaluation
      class Message
        type content_part = ContentPart::Text | ContentPart::ImageURL

        type content = String | Array[content_part]

        type serialized = Hash[Symbol, any]

        @role: Symbol

        @content: content?

        @tool_calls: Array[ToolCall]

        @tool_call_id: String?

        attr_reader role: Symbol

        attr_reader content: content?

        attr_reader tool_calls: Array[ToolCall]

        attr_reader tool_call_id: String?

        def initialize: (
          role: String | Symbol,
          ?content: content?,
          ?tool_calls: Array[ToolCall],
          ?tool_call_id: String?
        ) -> void

        def with_content: (content? content) -> Message

        def with_tool_calls: (Array[ToolCall] tool_calls) -> Message

        def to_h: () -> serialized
      end
    end
  end
end
