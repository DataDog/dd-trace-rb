module Datadog
  module AIGuard
    module Evaluation
      class Outcome
        @blocking_enabled: bool

        attr_reader result: Result

        attr_reader redaction: Redaction::Result

        attr_reader extra_tags: Hash[String, String]

        attr_reader extra_metastruct: Hash[String, Helpers::json]

        def initialize: (
          result: Result,
          redaction: Redaction::Result,
          blocking_enabled: bool,
          extra_tags: Helpers::json,
          extra_metastruct: Helpers::json
        ) -> void

        def block?: () -> bool

        private

        def normalize_extra_tags: (Helpers::json entries) -> Hash[String, String]

        def normalize_extra_metastruct: (Helpers::json entries) -> Hash[String, Helpers::json]

        def filter_extra_entries: (
          Helpers::json entries
        ) -> Array[{"key" => String, "value" => Helpers::json}]
      end
    end
  end
end
