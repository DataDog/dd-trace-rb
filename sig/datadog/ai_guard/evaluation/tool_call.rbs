module Datadog
  module AIGuard
    module Evaluation
      class ToolCall
        type input_arguments = String | Hash[any, any]

        @tool_name: String

        @id: String

        @arguments: String

        attr_reader tool_name: String

        attr_reader id: String

        attr_reader arguments: String

        def initialize: (String tool_name, id: String, arguments: input_arguments) -> void

        def with_arguments: (input_arguments arguments) -> ToolCall

        def to_h: () -> Hash[Symbol, any]
      end
    end
  end
end
