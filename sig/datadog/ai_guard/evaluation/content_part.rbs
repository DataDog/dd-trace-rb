module Datadog
  module AIGuard
    module Evaluation
      module ContentPart
        class Text
          attr_reader text: ::String

          def initialize: (::String text) -> void

          def type: () -> ::Symbol

          def with_text: (String text) -> Text

          def to_h: () -> Hash[Symbol, any]
        end

        class ImageURL
          attr_reader url: ::String

          def initialize: (::String url) -> void

          def type: () -> ::Symbol

          def to_h: () -> Hash[Symbol, any]
        end
      end
    end
  end
end
