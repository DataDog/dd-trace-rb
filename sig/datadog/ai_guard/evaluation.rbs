module Datadog
  module AIGuard
    module Evaluation
      type span_metadata = Hash[String | Symbol, Array[Message::serialized] | Helpers::json]

      def self.perform: (Array[Message] messages, ?allow_raise: bool) -> Result

      def self.perform_no_op: (Array[Message] messages) -> NoOpResult

      private

      def self.truncate_messages: (Array[Message] messages) -> Array[Message]

      def self.truncate_content: (Array[Message::serialized] serialized_messages) -> Array[Message::serialized]

      def self.truncate_content_value: (String content, Integer max_bytes) -> String
    end
  end
end
