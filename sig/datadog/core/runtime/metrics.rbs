module Datadog
  module Core
    module Runtime
      class Metrics < Core::Metrics::Client
        @services: Set[String]

        @service_tags: Array[String]?

        @runtime_id_enabled: bool

        @process_tags_enabled: bool

        def initialize: (telemetry: Core::Telemetry::Component, **untyped options) -> void

        def register_service: (String? service) -> Array[String]?

        def flush: () -> void

        def gc_metrics: () -> Hash[String, Integer]

        def try_flush: () { () -> void } -> void

        def default_metric_options: () -> Hash[Symbol, untyped]

        private

        attr_reader service_tags: Array[String]?

        attr_reader services: Set[String]

        attr_reader runtime_id_enabled: bool

        attr_reader process_tags_enabled: bool

        def compile_service_tags!: () -> Array[String]

        def nested_gc_metric: (String prefix, Symbol | String k, Integer | Hash[Symbol | String, untyped] v) -> Array[[String, Integer]]

        def to_metric_name: (String str) -> String

        def gauge_if_not_nil: (String metric_name, Numeric? metric_value) -> void

        def flush_yjit_stats: () -> void
      end
    end
  end
end
