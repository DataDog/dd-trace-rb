module Datadog
  module Core
    module Encoding
      module Encoder
        def content_type: () -> ::String

        def encode: (any obj) -> ::String

        def join: (::Array[::String] encoded_data) -> ::String

        def decode: (::String obj) -> any
      end

      module JSONEncoder
        extend Encoder

        CONTENT_TYPE: ::String

        def self?.content_type: () -> ::String

        def self?.encode: (any obj) -> ::String

        def self?.join: (::Array[::String] encoded_data) -> ::String

        def self?.decode: (::String obj) -> any
      end

      module MsgpackEncoder
        extend Encoder

        CONTENT_TYPE: ::String

        def self?.content_type: () -> ::String

        def self?.encode: (any obj) -> ::String

        def self?.join: (::Array[::String] encoded_data) -> ::String

        def self?.decode: (::String obj) -> any
      end
    end
  end
end
