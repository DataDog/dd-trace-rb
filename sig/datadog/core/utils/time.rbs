module Datadog
  module Core
    module Utils
      module Time
        type float_unit = :float_second | :float_millisecond | :float_microsecond

        type integer_unit = :second | :millisecond | :microsecond | :nanosecond

        MONOTONIC_CLOCK_ID: Integer

        def self.original_clock_gettime: (Symbol | Integer clock_id, float_unit | integer_unit unit) -> (Float | Integer)

        def self.get_time: (?float_unit unit) -> Float
                         | (?integer_unit unit) -> Integer

        def self.now: () -> ::Time

        def self.measure: (?float_unit unit) { () -> untyped } -> Float
                        | (?integer_unit unit) { () -> untyped } -> Integer

        def self.as_utc_epoch_ns: (::Time time) -> ::Integer
      end
    end
  end
end
