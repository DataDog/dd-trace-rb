module Datadog
  module Core
    module Utils
      module Forking
        @fork_pid: Integer

        def self.included: (Module base) -> void

        def self.extended: (Forking base) -> void

        def after_fork!: () { () -> untyped } -> bool

        def forked?: () -> bool

        def update_fork_pid!: () -> void

        def fork_pid: () -> Integer

        module ClassExtensions : Forking
          def initialize: (*untyped args) ?{ (?) -> untyped } -> void
        end
      end
    end
  end
end
