module Datadog
  module Core
    module Utils
      module Forking
        @fork_pid: Integer

        def self.included: (::Module base) -> void

        # Any object that extends Forking receives the instance methods as
        # singleton methods, so the extending base answers update_fork_pid!.
        interface _ExtendedBase
          def update_fork_pid!: () -> void
        end

        def self.extended: (_ExtendedBase base) -> void

        def after_fork!: () { () -> untyped } -> bool

        def forked?: () -> bool

        def update_fork_pid!: () -> void

        def fork_pid: () -> Integer

        module ClassExtensions
          def initialize: (*untyped args) { () -> untyped } -> untyped
                           | (*untyped args, **untyped kwargs) { () -> untyped } -> untyped
        end
      end
    end
  end
end
