module Datadog
  module Core
    module Workers
      module Polling
        DEFAULT_SHUTDOWN_TIMEOUT: 1

        # Mirrors the runtime hook: hosts of Polling get
        # IntervalLoop and Async::Thread included by
        # Polling.included, and Polling::PrependedMethods prepended.
        include IntervalLoop
        include Async::Thread
        include PrependedMethods

        def self.included: (Class | Module base) -> void

        module PrependedMethods
          def perform: (*untyped args) -> untyped
        end

        def stop: (?bool force_stop, ?::Integer | ::Float timeout) -> bool

        def enabled?: () -> bool

        def enabled=: (bool value) -> bool
      end
    end
  end
end
