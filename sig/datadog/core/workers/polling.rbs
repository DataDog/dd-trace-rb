module Datadog
  module Core
    module Workers
      module Polling : IntervalLoop, Async::Thread
        DEFAULT_SHUTDOWN_TIMEOUT: 1

        def self.included: (Module base) -> void

        module PrependedMethods : Polling
          def perform: (*untyped args) -> untyped
        end

        @enabled: bool

        def stop: (?bool force_stop, ?Numeric timeout) -> bool

        def enabled?: () -> bool

        def enabled=: (bool value) -> bool
      end
    end
  end
end
