module Datadog
  module Core
    module Workers
      module Async
        module Thread
          FORK_POLICY_STOP: :stop

          FORK_POLICY_RESTART: :restart

          SHUTDOWN_TIMEOUT: 1
          MUTEX_INIT: untyped

          @run_async: bool
          @mutex: ::Mutex?
          @mutex_after_fork: ::Mutex?
          @worker: ::Thread?
          @pid: ::Integer?
          @error: ::Exception?
          @result: untyped
          @fork_policy: (:stop | :restart)?

          # Hosts get these methods via prepend in Thread.included.
          include PrependedMethods

          def self.included: (untyped base) -> untyped
          module PrependedMethods
            def perform: (*untyped args) -> (untyped | nil)
          end

          attr_reader error: ::Exception?

          attr_reader result: untyped

          attr_writer fork_policy: untyped

          def join: (?untyped? timeout) -> bool

          def terminate: () -> (false | true)

          def run_async?: () -> bool

          def started?: () -> untyped

          def running?: () -> untyped

          def error?: () -> bool

          def completed?: () -> untyped

          def failed?: () -> untyped

          def forked?: () -> untyped

          def fork_policy: () -> untyped

          attr_writer result: untyped

          def mutex: () -> ::Mutex

          def after_fork: () -> nil

          private

          attr_reader pid: ::Integer?

          def mutex_after_fork: () -> ::Mutex

          def worker: () -> ::Thread?

          def start_async: () ?{ () -> untyped } -> untyped

          def start_worker: () ?{ () -> untyped } -> bool

          def stop_fork: () -> untyped

          def restart_after_fork: () ?{ () -> untyped } -> untyped
        end
      end
    end
  end
end
