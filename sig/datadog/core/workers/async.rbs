module Datadog
  module Core
    module Workers
      module Async
        module Thread
          type fork_policy = :stop | :restart

          FORK_POLICY_STOP: :stop

          FORK_POLICY_RESTART: :restart

          SHUTDOWN_TIMEOUT: 1

          MUTEX_INIT: ::Thread::Mutex

          def self.included: (Module base) -> void

          module PrependedMethods : Async::Thread
            def perform: (*untyped args) -> void
          end

          @run_async: bool

          @pid: Integer?

          @error: Exception?

          @result: untyped

          @fork_policy: fork_policy

          @mutex: ::Thread::Mutex?

          @mutex_after_fork: ::Thread::Mutex?

          @worker: ::Thread?

          attr_reader error: Exception?

          attr_reader result: untyped

          attr_writer fork_policy: fork_policy

          def join: (?Numeric? timeout) -> bool

          def terminate: () -> bool

          def run_async?: () -> bool

          def started?: () -> bool

          def running?: () -> bool

          def error?: () -> bool

          def completed?: () -> bool

          def failed?: () -> bool

          def forked?: () -> bool

          def fork_policy: () -> fork_policy

          attr_writer result: untyped

          def mutex: () -> ::Thread::Mutex

          def after_fork: () -> void

          private

          attr_reader pid: Integer?

          def mutex_after_fork: () -> ::Thread::Mutex

          %a{pure} def worker: () -> ::Thread?

          def start_async: () { () -> void } -> bool?

          def start_worker: () { () -> void } -> true

          def stop_fork: () -> void

          def restart_after_fork: () { () -> void } -> true?
        end
      end
    end
  end
end
