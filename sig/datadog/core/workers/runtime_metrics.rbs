module Datadog
  module Core
    module Workers
      class RuntimeMetrics < Worker
        include Workers::Polling

        include Workers::IntervalLoop

        include Workers::Async::Thread

        DEFAULT_FLUSH_INTERVAL: 10

        DEFAULT_BACK_OFF_MAX: 30

        @metrics: Core::Runtime::Metrics

        attr_reader metrics: Core::Runtime::Metrics

        def initialize: (telemetry: Core::Telemetry::Component, **untyped options) -> void

        def perform: () -> true

        def register_service: (String? service) -> Array[String]?

        def stop: (*untyped args) -> bool
      end
    end
  end
end
