module Datadog
  module Core
    module Workers
      module IntervalLoop
        BACK_OFF_RATIO: ::Float

        BACK_OFF_MAX: 5

        BASE_INTERVAL: 1
        MUTEX_INIT: untyped

        @in_iteration: bool
        @run_loop: bool
        @loop_base_interval: untyped
        @loop_back_off_ratio: ::Float
        @loop_back_off_max: ::Integer
        # rbs 4.2.0 lacks Numeric#* and Time::_Timeout, so wait timings stay
        # untyped, matching the IntervalLoop precedent.
        @loop_wait_time: untyped
        @mutex: ::Mutex?
        @shutdown: ::ConditionVariable?

        # Hosts get these methods via prepend in IntervalLoop.included.
        include PrependedMethods

        def self.included: (untyped base) -> untyped
        module PrependedMethods
          @in_iteration: bool

          def perform: (*untyped args) -> untyped

          def in_iteration?: () -> bool
        end

        def stop_loop: () -> (false | true)

        def work_pending?: () -> untyped

        def run_loop?: () -> bool

        def loop_base_interval: () -> untyped

        def loop_back_off_ratio: () -> untyped

        def loop_back_off_max: () -> untyped

        def loop_wait_time: () -> untyped

        def loop_wait_time=: (untyped value) -> untyped

        def loop_back_off!: () -> untyped
        def loop_wait_before_first_iteration?: () -> bool

        attr_writer loop_back_off_max: untyped

        attr_writer loop_back_off_ratio: untyped

        attr_writer loop_base_interval: untyped

        def mutex: () -> ::Mutex

        private

        def perform_loop: () { () -> untyped } -> (nil | untyped)

        def shutdown: () -> ::ConditionVariable
      end
    end
  end
end
