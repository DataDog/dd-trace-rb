module Datadog
  module Core
    module Workers
      module IntervalLoop
        BACK_OFF_RATIO: Float

        BACK_OFF_MAX: 5

        BASE_INTERVAL: 1

        MUTEX_INIT: ::Thread::Mutex

        def self.included: (Module base) -> void

        module PrependedMethods : IntervalLoop
          @in_iteration: bool

          def perform: (*untyped args) -> void

          def in_iteration?: () -> bool?
        end

        @run_loop: bool

        @loop_base_interval: Integer | Float

        @loop_back_off_ratio: Integer | Float

        @loop_back_off_max: Integer | Float

        @loop_wait_time: Integer | Float

        @mutex: ::Thread::Mutex?

        @shutdown: ConditionVariable?

        def stop_loop: () -> true

        def work_pending?: () -> bool

        def run_loop?: () -> bool

        def loop_base_interval: () -> (Integer | Float)

        def loop_back_off_ratio: () -> (Integer | Float)

        def loop_back_off_max: () -> (Integer | Float)

        def loop_wait_time: () -> (Integer | Float)

        def loop_wait_time=: ((Integer | Float) value) -> (Integer | Float)

        def loop_back_off!: () -> (Integer | Float)

        def loop_wait_before_first_iteration?: () -> bool

        def in_iteration?: () -> bool?

        attr_writer loop_back_off_max: (Integer | Float)

        attr_writer loop_back_off_ratio: (Integer | Float)

        attr_writer loop_base_interval: (Integer | Float)

        def mutex: () -> ::Thread::Mutex

        private

        def perform_loop: () { () -> void } -> nil

        def shutdown: () -> ConditionVariable
      end
    end
  end
end
