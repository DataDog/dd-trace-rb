module Datadog
  module Core
    module Workers
      module Queue
        include Polling

        def self.included: (untyped base) -> untyped
        include PrependedMethods
        module PrependedMethods
          def perform: (*untyped args) -> (untyped | nil)
        end

        def buffer: () -> untyped

        def enqueue: (*untyped args) -> untyped

        def dequeue: () -> untyped
        def work_pending?: () -> untyped

        attr_writer buffer: untyped

	def flush: (?timeout: Numeric?) -> bool?
	
	private
	
	def idle?: () -> bool
      end
    end
  end
end
