module Datadog
  module Core
    module Workers
      module Queue
        # Hosts of Queue also include Polling; see the comment in
        # queue.rb. Modeling it here makes the host contract visible
        # inside Queue's own methods (flush, idle?).
        include Polling

        def self.included: (untyped base) -> untyped
        # Hosts get these methods via prepend in Queue.included.
        include PrependedMethods
        module PrependedMethods
          def perform: (*untyped args) -> (untyped | nil)
        end

        def buffer: () -> untyped

        def enqueue: (*untyped args) -> untyped

        def dequeue: () -> untyped
        def work_pending?: () -> untyped

        attr_writer buffer: untyped

	def flush: (?timeout: Numeric?) -> bool?
	
	private
	
	def idle?: () -> bool
      end
    end
  end
end
