module Datadog
  module Core
    class Logger < ::Logger
      PREFIX: String

      LIB_DATADOG_DIR: String

      def initialize: (*untyped args) ?{ () -> untyped } -> void

      def add: (untyped severity, ?untyped? message, ?untyped? progname) { () -> untyped } -> untyped

      alias log add
    end
  end
end
