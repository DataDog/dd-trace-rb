module Datadog
  module Core
    module Metrics
      class Metric < Struct[Symbol | String | Numeric | Hash[Symbol, untyped] | nil]
        attr_accessor type: Symbol

        attr_accessor name: String?

        attr_accessor value: Numeric?

        attr_accessor options: Hash[Symbol, untyped]

        def self.new: (Symbol type, String? name, Numeric? value, ?Hash[Symbol, untyped]? options) -> instance

        def initialize: (*untyped args) -> void
      end
    end
  end
end
