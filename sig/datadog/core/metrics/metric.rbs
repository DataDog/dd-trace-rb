module Datadog
  module Core
    module Metrics
      class Metric < Struct[untyped]
        attr_accessor type: Symbol

        attr_accessor name: String?

        attr_accessor value: untyped

        attr_accessor options: Hash[untyped, untyped]

        def initialize: (Symbol type, String? name, untyped value, ?Hash[untyped, untyped]? options) -> void

        def self.new: (Symbol type, String? name, untyped value, ?Hash[untyped, untyped]? options) -> instance
      end
    end
  end
end
