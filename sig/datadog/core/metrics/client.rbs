module Datadog
  module Core
    module Metrics
      class Client
        include Options

        extend Options

        extend Helpers

        @telemetry: Core::Telemetry::Component

        @logger: Core::Logger

        @statsd: untyped

        @enabled: bool

        @dogstatsd_version: Gem::Version?

        attr_reader statsd: untyped

        attr_reader logger: Core::Logger

        attr_reader telemetry: Core::Telemetry::Component

        def initialize: (telemetry: Core::Telemetry::Component, ?logger: Core::Logger, ?statsd: untyped, ?enabled: bool, **untyped _) -> void

        def supported?: () -> bool

        def enabled?: () -> bool

        def enabled=: (bool enabled) -> bool

        def default_hostname: () -> String

        def default_port: () -> Integer

        def default_statsd_client: () -> Datadog::Statsd

        def configure: (?Hash[Symbol, untyped] options) -> void

        def send_stats?: () -> bool

        def count: (String stat, ?Integer? value, ?Hash[Symbol, untyped]? options) ?{ () -> [Integer, Hash[Symbol, untyped]?] } -> void

        def distribution: (String stat, ?Numeric? value, ?Hash[Symbol, untyped]? options) ?{ () -> [Numeric, Hash[Symbol, untyped]?] } -> void

        def increment: (String stat, ?Hash[Symbol, untyped]? options) ?{ () -> Hash[Symbol, untyped]? } -> void

        def gauge: (String stat, ?Numeric? value, ?Hash[Symbol, untyped]? options) ?{ () -> [Numeric, Hash[Symbol, untyped]?] } -> void

        def time: [T] (String stat, ?Hash[Symbol, untyped]? options) { () -> T } -> T

        def send_metrics: (Array[Metric] metrics) -> void

        def close: () -> void

        private

        def dogstatsd_version: () -> Gem::Version?

        IGNORED_STATSD_ONLY_ONCE: Utils::OnlyOnce

        def ignored_statsd_warning: () -> void
      end
    end
  end
end
