module Datadog
  module Core
    module Metrics
      class Client
        include Options

        extend Options

        extend Helpers

        @logger: Core::Logger

        @enabled: bool

        @dogstatsd_version: Gem::Version?

        attr_reader statsd: untyped

        attr_reader logger: Core::Logger

        attr_reader telemetry: Core::Telemetry::Component

        def initialize: (
          telemetry: Core::Telemetry::Component telemetry,
          ?statsd: untyped? statsd,
          ?enabled: bool enabled,
          ?logger: Core::Logger logger,
          **untyped _
        ) -> void

        def supported?: () -> bool

        def enabled?: () -> bool

        def enabled=: (untyped enabled) -> void

        def default_hostname: () -> String

        def default_port: () -> Integer

        def default_statsd_client: () -> untyped

        def configure: (?Hash[untyped, untyped] options) -> void

        def send_stats?: () -> bool

        def count: (untyped stat, ?untyped? value, ?untyped? options) ?{ () -> untyped } -> untyped

        def distribution: (untyped stat, ?untyped? value, ?untyped? options) ?{ () -> untyped } -> untyped

        def increment: (untyped stat, ?untyped? options) ?{ () -> untyped } -> untyped

        def gauge: (untyped stat, ?untyped? value, ?untyped? options) ?{ () -> untyped } -> untyped

        def time: (untyped stat, ?untyped? options) ?{ () -> untyped } -> untyped

        def send_metrics: (Array[Metric] metrics) -> void

        def close: () -> (untyped | nil)

        private

        def dogstatsd_version: () -> Gem::Version?

        IGNORED_STATSD_ONLY_ONCE: untyped

        def ignored_statsd_warning: () -> void
      end
    end
  end
end
