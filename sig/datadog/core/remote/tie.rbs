module Datadog
  module Core
    module Remote
      module Tie
        class Boot < Struct[[Symbol, Numeric]]
          def initialize: (Symbol? barrier, Numeric? time) -> void

          def self.new: (Symbol? barrier, Numeric? time) -> instance

          attr_reader barrier: Symbol

          attr_reader time: Numeric
        end

        def self.boot: () -> Boot?
      end
    end
  end
end
