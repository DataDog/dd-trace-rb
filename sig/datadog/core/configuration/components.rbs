module Datadog
  module Core
    module Configuration
      class Components
        PATCH_ONLY_ONCE: Utils::OnlyOnce

        @environment_logger_extra: Hash[Symbol, untyped]

        @open_feature_activation: Datadog::OpenFeature::Activation

        def self.build_health_metrics: (untyped settings, Core::Logger logger, Core::Telemetry::Component telemetry) -> Diagnostics::Health::Metrics

        def self.enable_symbol_database?: (untyped settings, Datadog::DI::Component? dynamic_instrumentation) -> bool

        def self.build_logger: (untyped settings) -> Core::Logger

        def self.build_runtime_metrics: (untyped settings, Core::Logger logger, Core::Telemetry::Component telemetry) -> Core::Runtime::Metrics

        def self.build_runtime_metrics_worker: (untyped settings, Core::Logger logger, Core::Telemetry::Component telemetry) -> Core::Workers::RuntimeMetrics

        def self.build_telemetry: (untyped settings, AgentSettings agent_settings, Core::Logger logger) -> Core::Telemetry::Component

        def self.build_crashtracker: (untyped settings, AgentSettings agent_settings, logger: Core::Logger) -> Core::Crashtracking::Component?

        def self.build_data_streams: (untyped settings, AgentSettings agent_settings, Core::Logger logger, Environment::AgentInfo agent_info) -> DataStreams::Processor?

        attr_reader health_metrics: Diagnostics::Health::Metrics

        attr_reader settings: untyped

        attr_reader agent_settings: AgentSettings

        attr_reader logger: Core::Logger

        attr_reader remote: Datadog::Core::Remote::Component?

        attr_reader profiler: untyped

        attr_reader runtime_metrics: Core::Workers::RuntimeMetrics

        attr_reader telemetry: Core::Telemetry::Component

        attr_reader tracer: Datadog::Tracing::Tracer

        attr_reader crashtracker: Core::Crashtracking::Component?

        attr_reader error_tracking: Datadog::ErrorTracking::Component?

        attr_reader dynamic_instrumentation: Datadog::DI::Component?

        attr_reader appsec: Datadog::AppSec::Component?

        attr_reader ai_guard: Datadog::AIGuard::Component?

        attr_reader agent_info: Datadog::Core::Environment::AgentInfo

        attr_reader data_streams: Datadog::DataStreams::Processor?

        attr_reader symbol_database: Datadog::SymbolDatabase::Component?

        def initialize: (untyped settings) -> void

        def after_fork: () -> void

        def reconfigure_sampler: (?untyped settings) -> void

        def startup!: (untyped settings, ?old_state: ComponentsState?) -> void

        def shutdown!: (?Components? replacement) -> void

        def state: () -> ComponentsState

        def open_feature: () -> Datadog::OpenFeature::Component?

        private

        attr_reader open_feature_activation: Datadog::OpenFeature::Activation
      end
    end
  end
end
