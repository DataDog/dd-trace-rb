module Datadog
  module Core
    module Configuration
      class Components
        PATCH_ONLY_ONCE: Core::Utils::OnlyOnce

        def self.build_health_metrics: (Settings settings, Core::Logger logger, Core::Telemetry::Component telemetry) -> Diagnostics::Health::Metrics

        def self.enable_symbol_database?: (Settings settings, Datadog::DI::Component? dynamic_instrumentation) -> bool

        def self.build_logger: (Settings settings) -> Core::Logger

        def self.build_runtime_metrics: (Settings settings, Core::Logger logger, Core::Telemetry::Component telemetry) -> Core::Runtime::Metrics

        def self.build_runtime_metrics_worker: (Settings settings, Core::Logger logger, Core::Telemetry::Component telemetry) -> Core::Workers::RuntimeMetrics

        def self.build_telemetry: (Settings settings, untyped agent_settings, Core::Logger logger) -> Core::Telemetry::Component

        def self.build_crashtracker: (Settings settings, untyped agent_settings, logger: Core::Logger) -> Datadog::Core::Crashtracking::Component?

        def self.build_data_streams: (Settings settings, untyped agent_settings, Core::Logger logger, Environment::AgentInfo agent_info) -> DataStreams::Processor?

        attr_reader settings: Settings

        attr_reader agent_settings: untyped

        attr_reader health_metrics: Diagnostics::Health::Metrics

        attr_reader logger: Core::Logger

        attr_reader profiler: untyped

        attr_reader dynamic_instrumentation: Datadog::DI::Component?

        attr_reader appsec: Datadog::AppSec::Component?

        attr_reader ai_guard: Datadog::AIGuard::Component?

        attr_reader symbol_database: Datadog::SymbolDatabase::Component?

        attr_reader crashtracker: Datadog::Core::Crashtracking::Component?

        attr_reader error_tracking: Datadog::ErrorTracking::Component?

        attr_reader runtime_metrics: Core::Workers::RuntimeMetrics

        attr_reader telemetry: Core::Telemetry::Component

        attr_reader tracer: untyped

        attr_reader remote: Datadog::Core::Remote::Component

        attr_reader agent_info: Datadog::Core::Environment::AgentInfo

        attr_reader data_streams: Datadog::DataStreams::Processor?

        def initialize: (Settings settings) -> void

        def after_fork: () -> void

        def startup!: (Settings settings, ?old_state: ComponentsState?) -> void

        def shutdown!: (?Components? replacement) -> void

        def state: () -> ComponentsState

        # Hot-swaps with a new sampler, holding the Components lock.
        def reconfigure_sampler: (?Settings settings) -> void

        def open_feature: () -> Datadog::OpenFeature::Component?

        private

        attr_reader open_feature_activation: Datadog::OpenFeature::Activation
      end
    end
  end
end
