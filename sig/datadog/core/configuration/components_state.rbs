module Datadog
  module Core
    module Configuration
      class ComponentsState
        @telemetry_enabled: bool

        @remote_started: bool

        @di_implicitly_enabled: bool

        @open_feature_providers: Array[OpenFeature::Provider]

        def initialize: (
          telemetry_enabled: bool,
          remote_started: bool?,
          ?di_implicitly_enabled: bool,
          ?open_feature_providers: Array[OpenFeature::Provider]
        ) -> void

        def telemetry_enabled?: () -> bool

        def remote_started?: () -> bool

        def di_implicitly_enabled?: () -> bool

        attr_reader open_feature_providers: Array[OpenFeature::Provider]
      end
    end
  end
end
