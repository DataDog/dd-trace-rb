module Datadog
  module Core
    module RefillableBucket
      @rate: Float | Integer

      @max_tokens: Numeric

      @tokens: Numeric

      @last_refill: Numeric

      attr_reader rate: Float | Integer

      attr_reader max_tokens: Numeric

      attr_reader last_refill: Numeric

      def available_tokens: () -> Numeric

      def balance_at: (Float now) -> Numeric

      private

      def initialize_bucket: (Float | Integer rate, Numeric max_tokens) -> void

      def refill: () -> void
    end
  end
end
