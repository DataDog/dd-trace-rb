module Datadog
  module Core
    module Environment
      module VariableHelpers
        def self.env_to_bool: (String | Array[String] var, ?deprecation_warning: bool) -> bool?
                             | [T] (String | Array[String] var, T default, ?deprecation_warning: bool) -> (bool | T)

        private def self.decode_array: (String | Array[String] var, bool deprecation_warning) -> String?
      end
    end
  end
end
