module Datadog
  module Core
    module Environment
      module YJIT
        def self?.inline_code_size: () -> Numeric?
        def self?.outlined_code_size: () -> Numeric?
        def self?.freed_page_count: () -> Numeric?
        def self?.freed_code_size: () -> Numeric?
        def self?.live_page_count: () -> Numeric?
        def self?.code_gc_count: () -> Numeric?
        def self?.code_region_size: () -> Numeric?
        def self?.object_shape_count: () -> Numeric?
        def self?.yjit_alloc_size: () -> Numeric?
