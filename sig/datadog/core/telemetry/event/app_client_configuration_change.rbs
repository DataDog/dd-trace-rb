module Datadog
  module Core
    module Telemetry
      module Event
        class AppClientConfigurationChange < Base
          type configuration_changes = Array[[String, any]] | Hash[String, any]

          @changes: configuration_changes
          @origin: String

          attr_reader changes: configuration_changes

          attr_reader origin: String

          def type: () -> "app-client-configuration-change"

          def initialize: (configuration_changes changes, String origin) -> void

          def payload: () -> { configuration: Array[telemetry_configuration] }

          def configuration: () -> Array[telemetry_configuration]

          def ==: (untyped other) -> untyped

          alias eql? ==

          def hash: () -> untyped
        end
      end
    end
  end
end
