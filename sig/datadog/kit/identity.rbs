module Datadog
  module Kit
    module Identity
      type trace = ::Datadog::Tracing::TraceOperation

      def self.set_user: (?trace? trace, ?::Datadog::Tracing::SpanOperation? span, id: ::String, ?email: ::String?, ?name: ::String?, ?session_id: ::String?, ?role: ::String?, ?scope: ::String?, **::String? others) -> void
                       | (?trace? trace, ?::Datadog::Tracing::SpanOperation? span, **::String? user_attributes) -> void

      private

      def self.set_trace_and_span_context: (::String method, ?trace? trace, ?::Datadog::Tracing::SpanOperation? span) { (trace, ::Datadog::Tracing::SpanOperation) -> void } -> void
    end
  end
end
