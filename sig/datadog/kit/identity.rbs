module Datadog
  module Kit
    module Identity
      type trace = ::Datadog::Tracing::TraceSegment | ::Datadog::Tracing::TraceOperation

      def self.set_user: (?trace? trace, ?::Datadog::Tracing::SpanOperation span, id: ::String, ?email: ::String?, ?name: ::String?, ?session_id: ::String?, ?role: ::String?, ?scope: ::String?, **untyped others) -> void

      private

      def self.set_trace_and_span_context: (String method, ?trace? trace, ?::Datadog::Tracing::SpanOperation? span) { (untyped trace, ::Datadog::Tracing::SpanOperation span) -> void } -> void
    end
  end
end
