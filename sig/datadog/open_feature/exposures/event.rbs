module Datadog
  module OpenFeature
    module Exposures
      module Event
        type t = Hash[Symbol, untyped]

        ALLOWED_FIELD_TYPES: Array[Class]

        TARGETING_KEY_FIELD: String

        def self.cache_key: (flag_key: String, targeting_key: String?) -> String

        def self.cache_value: (allocation_key: String, variant: String, serial_id: Integer?) -> String

        def self.build: (
          flag_key: String,
          allocation_key: String,
          variant: String,
          serial_id: Integer?,
          context: ::OpenFeature::SDK::EvaluationContext,
          features: SplitFeatures::features_t
        ) -> t

        private

        def self.current_timestamp_ms: () -> Integer

        def self.extract_attributes: (::OpenFeature::SDK::EvaluationContext) -> Hash[String, untyped]
      end
    end
  end
end
