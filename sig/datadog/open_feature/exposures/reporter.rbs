module Datadog
  module OpenFeature
    module Exposures
      class Reporter
        @worker: Worker

        @logger: Core::Logger

        @telemetry: Core::Telemetry::Component

        @datadog_logging_enabled: bool

        @deduplicator: Deduplicator

        def initialize: (
          Worker worker,
          telemetry: Core::Telemetry::Component,
          logger: Core::Logger,
          ?datadog_logging_enabled: bool
        ) -> void

        def record: (
          flag_key: String,
          allocation_key: String,
          variant: String,
          serial_id: Integer?,
          context: ::OpenFeature::SDK::EvaluationContext,
          features: SplitFeatures::features_t
        ) -> bool

        private

        def enqueue: (Event::t event) -> void

        def skip: (String flag_key, String reason) -> void
      end
    end
  end
end
