module Datadog
  module OpenFeature
    class Activation
      @settings: Core::Configuration::Settings

      @agent_settings: Core::Configuration::AgentSettings

      @remote: Core::Remote::Component?

      @logger: Core::Logger

      @telemetry: Core::Telemetry::Component

      @flag_selection_reporter: FlagSelectionReporter

      @claimed_flag_selection: Configuration::FlagSelection?

      @flag_selection_dropped: bool

      @component: Component?

      @configuration_source: Agentless::ConfigurationSource?

      @delivery_source: String?

      @remote_receivers: Array[Core::Remote::Dispatcher::Receiver]?

      @failure: String?

      @providers: Hash[Provider, bool]

      @activated: bool

      @delivery_started: bool

      @shutdown: bool

      @mutex: Thread::Mutex

      attr_reader component: Component?

      attr_reader failure: String?

      def initialize: (
        Core::Configuration::Settings settings,
        Core::Configuration::AgentSettings agent_settings,
        Core::Remote::Component? remote,
        logger: Core::Logger,
        telemetry: Core::Telemetry::Component
      ) -> void

      def activate: (Provider provider) -> Component?

      def startup!: () -> void

      def start!: () -> Component?

      def activated?: () -> bool

      def providers: () -> Array[Provider]

      def after_fork: () -> void

      def deactivate: (Provider provider) -> void

      def shutdown!: () -> void

      private

      def report_failure: (StandardError error, String description) -> void

      def open_feature_available?: () -> bool

      def activate_delivery: (Configuration::Source::Resolution resolution, Configuration::FlagSelection? flag_selection) -> Component?

      def start_delivery: (String source, Configuration::FlagSelection? flag_selection) -> bool

      def start_agentless: (Configuration::FlagSelection? flag_selection) -> bool

      def claim_flag_selection: (Configuration::FlagSelection? flag_selection, Configuration::AgentlessEndpoint? selected_endpoint) -> void

      def report_joining_flag_selection: (Configuration::FlagSelection? flag_selection) -> void

      def report_flag_selection_not_sent: (Configuration::FlagSelection flag_selection) -> void

      def start_remote_configuration: () -> bool

      def configuration_changed: (Component::configuration_event event) -> void
    end
  end
end
