module Datadog
  module OpenFeature
    module Hooks
      class DebugLoggingHook
        include ::OpenFeature::SDK::Hooks::Hook

        @logger: Core::Logger

        def self.available?: () -> bool

        def initialize: (Core::Logger logger) -> void

        def finally: (
          hook_context: ::OpenFeature::SDK::Hooks::HookContext,
          evaluation_details: ::OpenFeature::SDK::EvaluationDetails,
          **untyped _opts
        ) -> void

        private

        def extract_allocation_key: (
          ::OpenFeature::SDK::EvaluationDetails evaluation_details
        ) -> ::String?

        def targeting_key_presence: (::OpenFeature::SDK::EvaluationContext? evaluation_context) -> ("absent" | "present")
      end
    end
  end
end
