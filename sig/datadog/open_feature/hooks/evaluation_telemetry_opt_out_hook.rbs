module Datadog
  module OpenFeature
    module Hooks
      class EvaluationTelemetryOptOutHook
        PARAMETER: String

        @opted_out: bool

        @hook: FlagEvalMetricsHook | FlagEvalEVPHook

        def self.opted_out?: (::OpenFeature::SDK::EvaluationContext? evaluation_context) -> bool

        def initialize: (FlagEvalMetricsHook | FlagEvalEVPHook hook) -> void

        def before: (hook_context: ::OpenFeature::SDK::Hooks::HookContext, **untyped) -> nil

        def error: (hook_context: ::OpenFeature::SDK::Hooks::HookContext, **untyped) -> bool

        def finally: (
          hook_context: ::OpenFeature::SDK::Hooks::HookContext,
          evaluation_details: ::OpenFeature::SDK::EvaluationDetails,
          **untyped
        ) -> void
      end
    end
  end
end
