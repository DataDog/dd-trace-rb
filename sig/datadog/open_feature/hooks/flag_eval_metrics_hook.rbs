module Datadog
  module OpenFeature
    module Hooks
      class FlagEvalMetricsHook
        include ::OpenFeature::SDK::Hooks::Hook

        @metrics: Metrics::FlagEvalMetrics?

        def self.available?: () -> bool

        def initialize: (Metrics::FlagEvalMetrics? metrics) -> void

        def finally: (
          hook_context: ::OpenFeature::SDK::Hooks::HookContext,
          evaluation_details: ::OpenFeature::SDK::EvaluationDetails,
          **untyped _opts
        ) -> void

        private

        def record: (
          Metrics::FlagEvalMetrics metrics,
          ::String flag_key,
          (ResolutionDetails | ::OpenFeature::SDK::EvaluationDetails) evaluation_details
        ) -> void

        def dependency_evaluations: (
          ::OpenFeature::SDK::EvaluationDetails evaluation_details
        ) -> ::Array[ResolutionDetails]

        def extract_allocation_key: (
          (ResolutionDetails | ::OpenFeature::SDK::EvaluationDetails) evaluation_details
        ) -> ::String?
      end
    end
  end
end
