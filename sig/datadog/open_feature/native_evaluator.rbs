module Datadog
  module OpenFeature
    class NativeEvaluator
      INVALID_FLAG_CONFIGURATION_ERROR_MESSAGE: String

      @configuration: Core::FeatureFlags::Configuration

      @observe_full_evaluation_data: bool

      @object_values: ::Hash[String, ::Hash[String, untyped]]

      @object_values_mutex: ::Thread::Mutex

      attr_reader observe_full_evaluation_data: bool

      def initialize: (String configuration) -> void

      def get_assignment: (
        String flag_key,
        default_value: untyped,
        context: ::OpenFeature::SDK::EvaluationContext::fields_t,
        expected_type: Symbol,
        ?experimentation_opt_out_mode: Provider::experimentation_opt_out_mode
      ) -> ResolutionDetails

      private

      def valid_native_timestamp?: (Object timestamp) -> bool

      def resolved_value: (
        String flag_key,
        Symbol expected_type,
        Core::FeatureFlags::ResolutionDetails result,
        untyped default_value
      ) -> untyped

      def cache_object_value: (String flag_key, String variant, untyped value) -> untyped

      def build_resolution_details: (
        Core::FeatureFlags::ResolutionDetails result,
        untyped value
      ) -> ResolutionDetails

      def invalid_flag_configuration?: (Core::FeatureFlags::ResolutionDetails result) -> bool

      def invalid_flag_configuration_error: (untyped default_value) -> ResolutionDetails
    end
  end
end
