module Datadog
  module OpenFeature
    class NativeEvaluator
      @configuration: Core::FeatureFlags::Configuration
      @variant_type_mismatch_flags: ::Hash[::String, ::Array[::Symbol]]

      def initialize: (::String configuration) -> void

      def get_assignment: (
        ::String flag_key,
        default_value: untyped,
        context: ::OpenFeature::SDK::EvaluationContext::fields_t,
        expected_type: ::Symbol
      ) -> (Core::FeatureFlags::ResolutionDetails | ResolutionDetails)

      private

      def find_variant_type_mismatch_flags: (::String configuration) -> ::Hash[::String, ::Array[::Symbol]]

      def expected_types_for: (untyped variation_type) -> (::Array[::Symbol]?)

      def variant_value_matches?: (untyped variation_type, untyped value) -> bool
    end
  end
end
