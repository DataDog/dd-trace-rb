module Datadog
  module DI
    module EL
      class Evaluator
        type collection = Array[Object] | Hash[Object, Object]

        MATCHES_TIMEOUT_SECONDS: ::Float

        EVALUATION_DEADLINE_CHECK_INTERVAL: Integer

        ARRAY_EACH: UnboundMethod

        HASH_EACH: UnboundMethod

        HASH_SELECT: UnboundMethod

        IDENTITY_MODE_CHECK: UnboundMethod

        @regexps: ::Array[::Regexp]

        def initialize: (?::Array[::Regexp] regexps) -> void

        def evaluate: (Context context, Float evaluation_deadline) -> Object

        def regexps: () -> ::Array[::Regexp]

        def self.compile_regexp: (::String needle) -> ::Regexp

        def self.evaluation_deadline: (Core::Configuration::Settings settings) -> Float

        def self.evaluation_deadline_exceeded?: (Float evaluation_deadline) -> bool

        def ref: (Context context, (Symbol | String) var) -> Object?

        def iref: (Context context, (Symbol | String) var) -> Object?

        def len: (any var, (Symbol | String) var_name) -> Integer

        def is_empty: (any var, (Symbol | String) var_name) -> bool

        def is_undefined: (any var, (Symbol | String) var_name) -> bool

        def contains: (any haystack, any needle) -> bool

        def matches: (String haystack, String needle, Float evaluation_deadline) -> bool

        def matches_compiled: (::String haystack, ::Integer index, Float evaluation_deadline) -> bool

        private def bounded_match?: (::Regexp re, ::String haystack) -> bool

        def getmember: (any object, (Symbol | String) field) -> any

        def index: (collection array_or_hash, any index_or_key) -> any

        def substring: (String object, Integer from, Integer to) -> String?

        def starts_with: (any haystack, String needle) -> bool

        def ends_with: (any haystack, String needle) -> bool

        def all: (collection collection, Float evaluation_deadline) { (Object, Object?, Object?) -> Object } -> bool

        def any: (collection collection, Float evaluation_deadline) { (Object, Object?, Object?) -> Object } -> bool

        def filter: (collection collection, Float evaluation_deadline) { (Object, Object?, Object?) -> Object } -> collection

        private def filter_hash: (Hash[Object, Object] collection, Float evaluation_deadline) { (Object, Object?, Object?) -> Object } -> Hash[Object, Object]

        private def raise_if_evaluation_deadline_exceeded: (Float evaluation_deadline) -> void

        private def raise_if_deadline_check_due_and_exceeded: (Integer item_index, Float evaluation_deadline) -> void

        private def each_collection_item: (collection collection, Float evaluation_deadline, String operator_name) { (Object, Object?, Object?) -> any } -> void

        def instanceof: (any object, String cls_name) -> bool
      end
    end
  end
end
