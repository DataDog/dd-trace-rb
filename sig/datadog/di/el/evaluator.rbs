module Datadog
  module DI
    module EL
      class Evaluator
        MATCHES_TIMEOUT_SECONDS: ::Float

        EVALUATION_DEADLINE_CHECK_INTERVAL: Integer

        EVALUATION_TIMEOUT_MESSAGE: String

        ARRAY_EACH: UnboundMethod

        HASH_EACH: UnboundMethod

        IDENTITY_MODE_CHECK: UnboundMethod

        @regexps: ::Array[::Regexp]

        def initialize: (?::Array[::Regexp] regexps) -> void

        def evaluate: (Context context, Float? deadline) -> Object

        def regexps: () -> ::Array[::Regexp]

        def self.compile_regexp: (::String needle) -> ::Regexp

        def self.evaluation_deadline: (Core::Configuration::Settings settings) -> Float?

        def self.evaluation_deadline_exceeded?: (Float? deadline) -> bool

        def ref: (Context context, (Symbol | String) var) -> Object

        def iref: (Context context, (Symbol | String) var) -> Object

        def len: (any var, (Symbol | String) var_name) -> Integer

        def is_empty: (any var, (Symbol | String) var_name) -> bool

        def is_undefined: (any var, (Symbol | String) var_name) -> bool

        def contains: (any haystack, any needle) -> bool

        def matches: (String haystack, String needle) -> bool

        def matches_compiled: (::String haystack, ::Integer index) -> bool

        private def bounded_match?: (::Regexp re, ::String haystack) -> bool

        def getmember: (any object, (Symbol | String) field) -> any

        def index: (Array[any] | Hash[any, any] array_or_hash, any index_or_key) -> any

        def substring: (String object, Integer from, Integer to) -> String?

        def starts_with: (any haystack, String needle) -> bool

        def ends_with: (any haystack, String needle) -> bool

        def all: (Array[Object] | Hash[Object, Object] collection, Float? deadline) { (Object, ?Object, ?Object) -> Object } -> bool

        def any: (Array[any] | Hash[any, any] collection, Float? deadline) { (?) -> any } -> bool

        def filter: (Array[any] | Hash[any, any] collection, Float? deadline) { (?) -> any } -> (Array[any] | Hash[any, any])

        private def filter_hash: (Hash[any, any] collection, Float? deadline) { (?) -> any } -> Hash[any, any]

        private def raise_if_evaluation_deadline_exceeded: (Integer item_index, Float? deadline) -> void

        def instanceof: (any object, String cls_name) -> bool
      end
    end
  end
end
