module Datadog
  module DI
    class Correlation
      DEFAULT_MAX_ENTRIES: Integer

      TOP_RATE: Integer

      GLOBAL_RATE: Integer

      PER_PROBE_BUDGET: Integer

      ALL_BUDGET: Integer

      @max_entries: Integer

      @per_probe_budget: Integer

      @all_budget: Integer

      @lock: ::Thread::Mutex

      @trace_budgets: Hash[Integer, TraceBudget]

      @top_limiter: Core::TokenBucket

      @global_limiter: Core::BorrowingTokenBucket

      def initialize: (?max_entries: Integer, ?top_rate: (Float | Integer), ?global_rate: (Float | Integer), ?per_probe_budget: Integer, ?all_budget: Integer) -> void

      def emit?: (Probe probe, SamplingUnit sampling_unit) -> bool

      private

      attr_reader lock: ::Thread::Mutex

      attr_reader trace_budgets: Hash[Integer, TraceBudget]

      attr_reader top_limiter: Core::TokenBucket

      attr_reader global_limiter: Core::BorrowingTokenBucket

      attr_reader max_entries: Integer

      attr_reader per_probe_budget: Integer

      attr_reader all_budget: Integer

      def per_probe: (Probe probe) -> bool

      def fetch_budget: (Integer key) -> TraceBudget?

      def top: (Integer key, Probe probe) -> bool

      def correlated: (TraceBudget budget, Probe probe) -> bool

      def store: (Integer key, TraceBudget budget) -> void

      class TraceBudget
        @all: Integer

        @per_probe_limit: Integer

        @per_probe: Hash[String, Integer]

        def initialize: (Integer all, Integer per_probe_limit) -> void

        attr_reader all: Integer

        def admit: (String probe_id) -> bool
      end
    end
  end
end
