module Datadog
  module DI
    class Correlation
      DEFAULT_MAX_ENTRIES: Integer

      @settings: Datadog::Core::Configuration::Settings

      @logger: DI::Logger

      @telemetry: Core::Telemetry::Component?

      @max_entries: Integer

      @lock: ::Thread::Mutex

      @unit_decisions: Hash[untyped, bool]

      @cap_scopes: Hash[untyped, Set[untyped]]

      def initialize: (Datadog::Core::Configuration::Settings settings, DI::Logger logger, ?telemetry: Core::Telemetry::Component?, ?max_entries: Integer) -> void

      attr_reader settings: Datadog::Core::Configuration::Settings

      attr_reader logger: DI::Logger

      attr_reader telemetry: Core::Telemetry::Component?

      attr_reader max_entries: Integer

      def emit?: (Probe probe, ExecutionUnit unit) -> bool

      private

      def per_probe: (Probe probe) -> bool

      def unit_decision: (untyped key) { () -> bool } -> bool

      def cap_admit: (untyped scope, untyped probe_id) -> bool

      def evict: (Hash[untyped, untyped] map) -> void
    end
  end
end
