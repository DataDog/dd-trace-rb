module Datadog
  module DI
    class Correlation
      DEFAULT_MAX_ENTRIES: Integer

      @max_entries: Integer

      @lock: ::Thread::Mutex

      @unit_decisions: Hash[untyped, bool]

      @cap_scopes: Hash[untyped, Set[untyped]]

      def initialize: (?max_entries: Integer) -> void

      def emit?: (Probe probe, ExecutionUnit unit) -> bool

      private

      attr_reader lock: ::Thread::Mutex

      attr_reader unit_decisions: Hash[untyped, bool]

      attr_reader cap_scopes: Hash[untyped, Set[untyped]]

      attr_reader max_entries: Integer

      def per_probe: (Probe probe) -> bool

      def unit_decision: (untyped key) { () -> bool } -> bool

      def cap_admit: (untyped scope, untyped probe_id) -> bool

      def evict: (Hash[untyped, untyped] map) -> void
    end
  end
end
