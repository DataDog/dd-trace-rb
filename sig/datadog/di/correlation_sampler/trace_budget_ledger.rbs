module Datadog
  module DI
    class CorrelationSampler
      class TraceBudgetLedger
        @sweep_threshold: Integer

        @entries: Hash[Integer, Entry]

        @live_count: Integer

        def initialize: (Integer sweep_threshold) -> void

        attr_reader sweep_threshold: Integer

        attr_reader entries: Hash[Integer, Entry]

        def fetch: (Datadog::Tracing::TraceOperation trace) -> TraceBudget?

        def store: (Datadog::Tracing::TraceOperation trace, TraceBudget budget) -> void

        private

        attr_reader live_count: Integer

        def sweep_bound: () -> Integer

        def sweep: () -> void
      end
    end
  end
end
