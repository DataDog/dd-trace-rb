module Datadog
  module DI
    class ProcResponder
      @executed_proc: Proc

      @failed_proc: Proc?

      @recorded_proc: Proc?

      def initialize: (Proc executed_proc, ?Proc? failed_proc, ?Proc? recorded_proc) -> void

      attr_reader executed_proc: Proc

      attr_reader failed_proc: Proc?

      attr_reader recorded_proc: Proc?

      def probe_executed_callback: (Context context) -> untyped

      def probe_expression_evaluation_failed_callback: (Context context, EL::Expression expr, Exception exc) -> void

      def probe_metric_recorded_callback: (Probe probe) -> void

      def probe_disabled_callback: (Probe probe, Float duration) -> void
    end
  end
end
