module Datadog
  module DI
    module Transport
      module Input
        class Request < Datadog::Core::Transport::Request
          @serialized_tags: String

          attr_reader serialized_tags: String

          def initialize: (Core::Transport::Parcel parcel, String serialized_tags) -> void
        end

        class Transport < Core::Transport::Transport
          @telemetry: Datadog::Core::Telemetry::Component?

          @guardrails_telemetry: DI::GuardrailsTelemetry

          @pruned_snapshot_count: Integer

          @last_pruned_at: Float?

          MAX_SERIALIZED_SNAPSHOT_SIZE: Integer
          SIZE_CAP_HEADROOM: Integer
          SNAPSHOT_SIZE_CAP: Integer
          DEFAULT_CHUNK_SIZE: Integer

          attr_reader telemetry: Datadog::Core::Telemetry::Component?

          attr_reader guardrails_telemetry: DI::GuardrailsTelemetry

          attr_reader pruned_snapshot_count: Integer

          attr_reader last_pruned_at: Float?

          def initialize: (
            Datadog::Core::Transport::HTTP::API::Map apis,
            String default_api,
            logger: DI::Logger,
            guardrails_telemetry: DI::GuardrailsTelemetry,
            ?telemetry: Datadog::Core::Telemetry::Component?
          ) -> void

          def send_input: (Array[SnapshotEvent] payload, Hash[String, String] tags, on_serialization_error: ^(String, Exception) -> void) -> Array[SnapshotEvent]

          def send_input_chunk: (String chunked_payload, String serialized_tags) -> (Core::Transport::HTTP::Response | Core::Transport::InternalErrorResponse)

          def encoder: () -> singleton(Core::Encoding::JSONEncoder)

          def logger: () -> DI::Logger

          def reset_pruning_state: () -> void

          private

          def record_pruned_snapshot: () -> void
        end
      end
    end
  end
end
