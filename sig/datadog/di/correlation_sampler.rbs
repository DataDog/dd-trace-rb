module Datadog
  module DI
    class CorrelationSampler
      DEFAULT_SWEEP_THRESHOLD: Integer

      TOP_RATE: Integer

      GLOBAL_RATE: Integer

      PER_PROBE_BUDGET: Integer

      ALL_BUDGET: Integer

      @per_probe_budget: Integer

      @all_budget: Integer

      @sweep_threshold: Integer

      @top_rate: (Float | Integer)

      @global_rate: (Float | Integer)

      @lock: Thread::Mutex

      @trace_budgets: TraceBudgetLedger

      @top_limiter: Core::TokenBucket

      @global_limiter: Core::BorrowingTokenBucket

      def initialize: (?sweep_threshold: Integer, ?top_rate: (Float | Integer), ?global_rate: (Float | Integer), ?per_probe_budget: Integer, ?all_budget: Integer) -> void

      def emit_with_reason?: (Probe probe, Datadog::Tracing::TraceOperation? trace) -> [bool, Symbol?]

      def emit?: (Probe probe, Datadog::Tracing::TraceOperation? trace) -> bool

      def admit_process_wide_snapshot?: () -> bool

      def after_fork!: () -> void

      private

      attr_reader lock: Thread::Mutex

      attr_reader trace_budgets: TraceBudgetLedger

      attr_reader top_limiter: Core::TokenBucket

      attr_reader global_limiter: Core::BorrowingTokenBucket

      attr_reader per_probe_budget: Integer

      attr_reader all_budget: Integer

      attr_reader sweep_threshold: Integer

      attr_reader top_rate: (Float | Integer)

      attr_reader global_rate: (Float | Integer)

      def rebuild_state: () -> void

      def emit_uncorrelated?: (Probe probe) -> [bool, Symbol?]

      def emit_top?: (Probe probe, Datadog::Tracing::TraceOperation trace) -> [bool, Symbol?]

      def emit_correlated?: (TraceBudget budget, Probe probe) -> [bool, Symbol?]

      def store: (Datadog::Tracing::TraceOperation trace, TraceBudget budget) -> void
    end
  end
end
