module Datadog
  module DI
    TELEMETRY_NAMESPACE: String

    class GuardrailsTelemetry
      include Core::Telemetry::_MetricSource

      type counts_by_event_type = Hash[String, Hash[String, Integer]]

      type skipped_counts_table = Hash[String, Hash[String, Hash[String?, Integer]]]

      EVENTS_SKIPPED: String

      EVENTS_DROPPED: String

      CAPTURE_INCOMPLETE: String

      QUEUE_DROPPED_BYTES: String

      EVENT_TYPE_SNAPSHOT: String

      EVENT_TYPE_LOG: String

      @settings: Datadog::Core::Configuration::Settings

      @logger: DI::Logger

      @telemetry: Core::Telemetry::Component?

      @counts_lock: Thread::Mutex

      @skipped_counts: skipped_counts_table

      @dropped_counts: counts_by_event_type

      @dropped_bytes: counts_by_event_type

      @capture_incomplete_counts: counts_by_event_type

      @last_reported_at: Time?

      def initialize: (settings: Datadog::Core::Configuration::Settings, logger: DI::Logger, telemetry: Core::Telemetry::Component?) -> void

      attr_reader settings: Datadog::Core::Configuration::Settings

      attr_reader logger: DI::Logger

      attr_reader telemetry: Core::Telemetry::Component?

      attr_reader counts_lock: Thread::Mutex

      attr_reader skipped_counts: skipped_counts_table

      attr_reader dropped_counts: counts_by_event_type

      attr_reader dropped_bytes: counts_by_event_type

      attr_reader capture_incomplete_counts: counts_by_event_type

      attr_reader last_reported_at: Time?

      def self.probe_event_type_tag: (Probe probe) -> String

      def counting?: () -> bool

      def skipped: (reason: String, probe: Probe) -> void

      def dropped: (reason: String, event_type: String, ?bytes: Integer?) -> void

      def capture_incomplete: (reason: String, event_type: String) -> void

      def report_metrics: (Core::Telemetry::MetricsManager metrics_manager) -> void

      def clear_metrics: () -> void

      private

      def reset_counts: () -> void

      def take_counts: () -> [skipped_counts_table, counts_by_event_type, counts_by_event_type, counts_by_event_type]

      def add_count: (counts_by_event_type table, String reason, String event_type, Integer value) -> void

      def record_table: (Core::Telemetry::MetricsManager metrics_manager, String metric_name, counts_by_event_type table) -> Integer

      def record_metric: (Core::Telemetry::MetricsManager metrics_manager, String metric_name, Integer value, Hash[Symbol, String] tags) -> void

      def report_emission_failure: (String namespace, String metric_name, Exception exc) -> void
    end
  end
end
