module Datadog
  module DI
    class CaptureExpressionEvaluator
      class Result
        @serialized_values: Hash[String, untyped]

        @errors: Array[EvaluationFailure]

        def initialize: (serialized_values: Hash[String, untyped], errors: Array[EvaluationFailure]) -> void

