module Datadog
  module DI
    module SnapshotEncoder
      # JSON-compatible value as produced by ProbeNotificationBuilder and
      # Serializer: Symbol keys, Integer line-number keys under
      # captures.lines, and String keys in custom serializer output.
      type snapshot_value = String | Integer | Float | bool | nil
        | Array[snapshot_value]
        | Hash[Symbol | Integer | String, snapshot_value]

      # Snapshot payload Hash, in the shape send_input receives it.
      type snapshot = Hash[Symbol | Integer | String, snapshot_value]

      MAX_ITEM_BYTES: Integer
      SLOT_OVERHEAD: Integer
      MAX_ESCAPE_EXPANSION: Integer
      SLOT_STRING_FIELDS: Array[String]
      PRUNED: Hash[String, true]
      PRUNED_ENCODED: String
      KEY_JSON: Hash[String, String]

      class Result < Struct[String? | bool]
        attr_reader encoded: String?
        attr_reader pruned: bool

        def self.new: (String? encoded, bool pruned) -> instance
      end

      class Budget
        attr_reader remaining: Integer

        def initialize: (Integer remaining) -> void

        def consume: (Integer bytes) -> void
      end

      def self.encode: (snapshot snapshot, Integer max_size) -> Result

      def self.encode_value: (snapshot_value node, String out, Budget budget) ?{ () -> void } -> bool

      def self.encode_slot:
        (snapshot_value slot, String out, Budget budget, item_cap: Integer?) ?{ () -> void } -> bool

      def self.encode_slot_body: (snapshot slot, String out, Budget budget) ?{ () -> void } -> bool

      def self.encode_elements: (snapshot_value elements, String out, Budget budget) ?{ () -> void } -> bool

      def self.encode_entries: (snapshot_value entries, String out, Budget budget) ?{ () -> void } -> bool

      def self.encode_slot_pair: (Array[snapshot_value] pair, String out, Budget budget) ?{ () -> void } -> bool

      def self.encode_fields: (snapshot_value fields, String out, Budget budget) ?{ () -> void } -> bool

      def self.encode_slot_hash: (snapshot_value hash, String out, Budget budget) ?{ () -> void } -> bool

      def self.encode_envelope_hash: (snapshot hash, String out, Budget budget) ?{ () -> void } -> bool

      def self.encode_envelope_array: (Array[snapshot_value] array, String out, Budget budget) ?{ () -> void } -> bool

      def self.encode_scalar: (snapshot_value scalar, String out, Budget budget) -> bool

      def self.emit_json_fragment: (String out, Budget budget, String fragment) -> bool

      def self.emit_pruned: (String out, Budget budget) ?{ () -> void } -> bool

      def self.slot_collection?: (snapshot slot) -> bool

      def self.slot_upper_bound: (snapshot slot) -> Integer

      def self.slot_lower_bound: (snapshot slot) -> Integer

      def self.slot_string_fields_bound:
        (snapshot slot, bytes_per_byte: Integer, bytes_per_field: Integer) -> Integer

      def self.field_value: (snapshot slot, String field) -> (snapshot_value | nil)
    end
  end
end
