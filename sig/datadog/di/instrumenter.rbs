module Datadog
  module DI
    class Instrumenter
      class Location
        def initialize: (String path, Integer lineno, String? label) -> void

        def path: () -> String
        def lineno: () -> Integer
        def label: () -> String?
      end

      DATADOG_NAMESPACE_TYPE_NAME: ::Regexp

      GLOBAL_SNAPSHOT_RATE_LIMIT: ::Integer

      GLOBAL_LOG_RATE_LIMIT: ::Integer

      @settings: Datadog::Core::Configuration::Settings

      @serializer: Serializer

      @code_tracker: CodeTracker?

      @logger: DI::Logger

      @telemetry: Core::Telemetry::Component?

      @guardrails_telemetry: GuardrailsTelemetry

      @global_snapshot_rate_limiter: Datadog::Core::TokenBucket

      @global_log_rate_limiter: Datadog::Core::TokenBucket

      @lock: Mutex

      @capture_expression_evaluator: CaptureExpressionEvaluator

      def initialize: (Datadog::Core::Configuration::Settings settings, Serializer serializer, DI::Logger logger, guardrails_telemetry: GuardrailsTelemetry, capture_expression_evaluator: CaptureExpressionEvaluator, ?code_tracker: CodeTracker?, ?telemetry: Core::Telemetry::Component?) -> void

      attr_reader settings: Datadog::Core::Configuration::Settings

      attr_reader serializer: Serializer

      attr_reader code_tracker: CodeTracker?

      attr_writer code_tracker: CodeTracker?

      attr_reader logger: DI::Logger

      attr_reader telemetry: Core::Telemetry::Component?

      attr_reader guardrails_telemetry: GuardrailsTelemetry

      attr_reader global_snapshot_rate_limiter: Datadog::Core::TokenBucket

      attr_reader global_log_rate_limiter: Datadog::Core::TokenBucket

      attr_reader capture_expression_evaluator: CaptureExpressionEvaluator

      def probe_global_rate_limiter: (Probe probe) -> Datadog::Core::TokenBucket

      interface _ProbeResponder
        def probe_executed_callback: (Context context) -> void

        def probe_condition_evaluation_failed_callback: (Context context, EL::Expression expr, Exception exc) -> void

        def probe_disabled_callback: (Probe probe, Float duration) -> void
      end

      def record_rate_limit_skip: (String reason, Probe probe) -> void

      def hook_method: (Probe probe, _ProbeResponder responder) -> void

      def unhook_method: (Probe probe) -> void
      def hook_line: (Probe probe, _ProbeResponder responder) -> bool?

      def unhook_line: (Probe probe) -> void

      def hook: (Probe probe, _ProbeResponder responder) -> void

      def unhook: (Probe probe) -> void

      def self.get_local_variables: (TracePoint trace_point) -> Hash[Symbol, untyped]
      def self.get_instance_variables: (Object self) -> Hash[Symbol, untyped]

      # The customer-supplied method's arguments, target object and return
      # value carry the probed application's signature, which is unknown at
      # this layer.
      def run_method_probe: [X < Object] (Array[any] args, Hash[Symbol, any] kwargs, Proc? target_block, any target_self, Probe probe, _ProbeResponder responder, [String, Integer]? loc, String method_name) { () -> X } -> X

      # Ruby < 3 only. Splits a splat-captured argument list into
      # [positional_args, kwargs]; the trailing hash, if any, becomes kwargs.
      def kwargs_from_splat: (::Array[untyped] args) -> [::Array[untyped], ::Hash[untyped, untyped]]

      private

      attr_reader lock: Mutex

      def line_trace_point_callback: (Probe probe, RubyVM::InstructionSequence? iseq, _ProbeResponder responder, TracePoint tp) -> void

      def build_trace_point_context: (Probe probe, TracePoint tp) -> Context

      def check_and_disable_if_exceeded: (Probe probe, _ProbeResponder responder, Float di_start_time, ?Float accumulated_duration) -> void

      def symbolize_class_name: (String? cls_name) -> Module
      def datadog_namespace_type_name?: (::String cls_name) -> bool
      def raise_if_probe_in_loaded_features: (Probe probe, Integer line_no, CodeTracker? code_tracker) -> void
    end
  end
end
