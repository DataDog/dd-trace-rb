module Datadog
  module Tracing
    class DefaultContextProvider
      @context: FiberLocalContext
      @otel_thread_context: OTelThreadContext?

      def initialize: (?otel_thread_context: OTelThreadContext?, ?local_context: FiberLocalContext) -> void
      def context=: (untyped ctx) -> untyped
      def context: (?untyped? key) -> untyped
    end

    class FiberLocalContext
      @key: Symbol
      @otel_thread_context: OTelThreadContext?

      def initialize: (?otel_thread_context: OTelThreadContext?) -> void
      def local=: (untyped ctx) -> untyped
      def local: (?untyped storage) -> untyped
      UNIQUE_INSTANCE_MUTEX: untyped

      UNIQUE_INSTANCE_GENERATOR: untyped

      def self.next_instance_id: () -> untyped
    end

    class FiberInheritedContext < FiberLocalContext
      def local=: (Context? ctx) -> Context?
      def local: (?untyped storage) -> Context

      private

      def inherited_context: () -> Context?
    end
  end
end
