module Datadog
  module Tracing
    module Contrib
      module Ethon
        module EasyPatch
          def self.included: [T < Module] (T base) -> T

          module InstanceMethods
            include Contrib::HttpAnnotationHelper

            def http_request: (String url, String | Symbol action_name, ?Hash[Symbol, untyped] options) -> void

            def headers=: (Hash[any, any]? headers) -> void

            def perform: () -> Symbol

            def complete: () -> Array[Proc]?

            def reset: () -> void

            def datadog_before_request: (?continue_from: TraceDigest?) -> void

            def datadog_span_started?: () -> bool

            private

            attr_reader datadog_configuration: Configuration::Settings

            def datadog_tag_request: (URI::Generic? uri) -> bool?

            def set_span_error_message: (String message) -> void

            def try_parse_uri: () -> URI::Generic?

            def load_datadog_configuration_for: (?(String | Symbol) host) -> Configuration::Settings

            def analytics_enabled?: () -> bool

            def analytics_sample_rate: () -> Float

            def parse_response_headers: () -> Hash[String, String]
          end
        end
      end
    end
  end
end
