module Datadog
  module Tracing
    module Contrib
      module Faraday
        interface _App
          def call: (::Faraday::Env env) -> ::Faraday::Response
        end

        class Middleware < ::Faraday::Middleware
          include Contrib::HttpAnnotationHelper

          type request_options = {
            ?enabled: bool,
            ?distributed_tracing: bool,
            ?analytics_enabled: bool?,
            ?analytics_sample_rate: Numeric?,
            ?service_name: String?,
            ?peer_service: String?,
            ?split_by_domain: bool,
            ?on_error: Proc?,
            ?error_status_codes: StatusRangeMatcher | Array[Integer] | Range[Integer],
          }

          def initialize: (_App app, ?request_options options) -> void

          def call: (::Faraday::Env env) -> ::Faraday::Response

          private

          def app: () -> _App

          def annotate!: (SpanOperation span, ::Faraday::Env env, request_options options) -> void

          def handle_response: (SpanOperation span, ::Faraday::Env env, request_options options) -> void

          def propagate!: (TraceOperation trace, any span, ::Faraday::Env env) -> void

          def resource_name: (::Faraday::Env env, String path) -> String

          def build_request_options!: (::Faraday::Env env) -> request_options

          def datadog_configuration: (?(String | Symbol)? host) -> Configuration::Settings
        end
      end
    end
  end
end
