module Datadog
  module Tracing
    module Contrib
      module Karafka
        module KafkaConfig
          def self.bootstrap_servers: (Hash[Symbol | String, any]? kafka_config) -> String?

          def self.with_job_bootstrap_servers: [T] (String? bootstrap_servers) { () -> T } -> T

