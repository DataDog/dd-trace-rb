module Datadog
  module Tracing
    module Contrib
      module Utils
        module RDSEndpoint
          type endpoint = { identifier: String, endpoint_type: String, region: String }

          # Either an `endpoint` or `NOT_AN_ENDPOINT`, keyed by the hostname as given.
          self.@cache: ::Hash[String, untyped]

          self.@cache_mutex: ::Thread::Mutex

          MAX_INPUT_BYTES: Integer

          MAX_CACHE_ENTRIES: Integer

          PORT_PATTERN: Regexp

          RDS_LABEL_PATTERN: Regexp

          REGION_PATTERNS_BY_DNS_SUFFIX: Hash[String, Regexp]

          DNS_SUFFIX_ALTERNATION: String

          ENDPOINT_PATTERN: Regexp

          ENDPOINT_TYPES_BY_PREFIX: Hash[String?, String]

          NOT_AN_ENDPOINT: Object

          def self.parse: (untyped hostname) -> endpoint?

          def self.annotate!: (SpanOperation span, untyped hostname) -> void

          private

          def self.fetch_or_parse: (String hostname) -> endpoint?

          def self.parse_endpoint: (String hostname) -> endpoint?

          def self.strip_port: (String candidate) -> String?
        end
      end
    end
  end
end
