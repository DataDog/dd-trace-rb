module Datadog
  module Tracing
    module Contrib
      module Utils
        module Quantization
          module HTTP
            PLACEHOLDER: "?"
            RFC3986_URL_BASE: Regexp

            type obfuscation_options = {
              ?regex: (Regexp | :internal)?,
              ?with: String?,
            }

            type query_options = {
              ?show: (Array[String] | :all)?,
              ?exclude: (Array[String] | :all)?,
              ?obfuscate: (obfuscation_options | :internal | false)?,
              ?placeholder: String?,
            }

            type url_options = {
              ?base: (:show | :exclude)?,
              ?query: query_options?,
              ?fragment: (:show)?,
              ?placeholder: String?,
            }

            def self?.client_resource: (String method, String? path, enabled: bool) -> String

            def self?.decode_path: (String path) -> String

            def self?.quantize_path: (String path) -> String

            def self?.decode_hex_byte: (Integer byte) -> Integer?

            def self?.url: (String url, ?url_options options) -> String

            def self?.base_url: (String url, ?any options) -> String?

            def self?.url!: (String url, ?url_options? options) -> String

            def self?.query: (String query, ?query_options options) -> String

            def self?.query!: (String query, ?query_options? options) -> String

            def self?.collect_query: (String query, ?{ ?uniq: bool? } options) ?{ (String?, String?, String?) -> [String?, String?] } -> String

            def self?.obfuscate_query: (String query, ?obfuscation_options options) -> String

            OBFUSCATOR_WITH: "<redacted>"
            OBFUSCATOR_REGEX: Regexp
          end
        end
      end
    end
  end
end
