module Datadog
  module Tracing
    module Contrib
      module HTTP
        module Instrumentation
          def self.included: (untyped base) -> untyped
          module InstanceMethods
            include Contrib::HttpAnnotationHelper
            def request: (untyped req, ?untyped? body) ?{ () -> untyped } -> untyped

            def annotate_span_with_request!: (untyped span, untyped request, untyped request_options) -> untyped

            def annotate_span_with_response!: (untyped span, untyped response, untyped request_options) -> (nil | untyped)

            def set_analytics_sample_rate: (untyped span, untyped request_options) -> (nil | untyped)

            private

            def connect: () -> untyped

            def connection_traceable?: () -> bool

            def annotate_span_with_connection!: (SpanOperation span, untyped request_options, untyped client_config) -> void

            def annotate_span_with_service!: (SpanOperation span, String? host, untyped request_options, untyped client_config) -> void

            def annotate_client_span!: (SpanOperation span, String operation, String? host, Integer? port, untyped request_options) -> void

            def report_annotation_error: (String annotated_object, Exception error) -> void

            def request_uri_path: (untyped request) -> String?

            def host_and_port: (untyped request) -> Array[untyped]

            def datadog_configuration: (?(Symbol | String) host) -> untyped

            def analytics_enabled?: (untyped request_options) -> untyped

            def analytics_sample_rate: (untyped request_options) -> untyped
          end
        end
      end
    end
  end
end
