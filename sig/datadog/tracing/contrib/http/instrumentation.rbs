module Datadog
  module Tracing
    module Contrib
      module HTTP
        module Instrumentation
          def self.included: [T < Module] (T base) -> T

          module InstanceMethods
            include Contrib::HttpAnnotationHelper

            def request: (Net::HTTPGenericRequest req, ?String? body) ?{ (Net::HTTPResponse) -> void } -> Net::HTTPResponse

            def annotate_span_with_request!: (SpanOperation span, Net::HTTPGenericRequest request, Configuration::Settings request_options) -> void

            def annotate_span_with_response!: (SpanOperation span, Net::HTTPResponse? response, Configuration::Settings request_options) -> void

            def set_analytics_sample_rate: (SpanOperation span, Configuration::Settings request_options) -> void

            private

            def request_uri_path: (Net::HTTPGenericRequest request) -> String?

            def host_and_port: (Net::HTTPGenericRequest request) -> [String?, Integer?]

            def datadog_configuration: (?(String | Symbol)? host) -> Configuration::Settings

            def analytics_enabled?: (Configuration::Settings request_options) -> bool

            def analytics_sample_rate: (Configuration::Settings request_options) -> Float
          end
        end
      end
    end
  end
end
