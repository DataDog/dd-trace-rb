module Datadog
  module Tracing
    module Contrib
      module ActiveJob
        module DataStreams : _Job
          # The host ActiveJob class this module is prepended onto.
          interface _Job
            def serialize: () -> ::Hash[::String, any]

            def deserialize: (::Hash[::String, any] job_data) -> void

            def queue_name: () -> ::String

            def perform_now: () -> untyped
          end

          def serialize: () -> ::Hash[::String, any]

          @datadog_pathway_context_before_job: Datadog::DataStreams::PathwayContext?

          def deserialize: (::Hash[::String, any] job_data) -> void

          def perform_now: () -> untyped
        end
      end
    end
  end
end
