module Datadog
  module Tracing
    module Contrib
      module Sequel
        module Utils
          JDBC_URI_PATTERN: Regexp
          DATABASE_PROPERTY_PATTERN: Regexp

          def self.adapter_name: (untyped database) -> untyped
          def self.database_type: (untyped database) -> untyped

          def self.parse_jdbc_uri: (String? uri) -> { host: String?, port: String?, database: String? }

          def self.parse_opts: (untyped sql, untyped opts, untyped db_opts, ?untyped? dataset) -> { name: untyped, query: untyped, prepared_name: untyped, database: untyped, host: untyped }

          def self.connection_metadata: (::Sequel::Database db) -> { host: String?, port: String?, database: String? }

          def self.set_common_tags: (untyped span, untyped db) -> untyped

          def self.set_connection_tags: (untyped span, untyped conn) -> untyped

          private

          def self.jdbc_metadata_from_connection: (::Sequel::Database db) -> { host: String?, port: String?, database: String? }?

          def self.connection_metadata_from_connection: (untyped conn) -> { host: String?, port: String?, database: String? }

          def self.jtopen_as400_connection_metadata: (untyped conn) -> { host: String?, port: String?, database: String? }?

          def self.jtopen_as400_connection?: (untyped conn) -> bool

          def self.jtopen_as400_system_name: (untyped conn) -> String?

          def self.pg_connection_metadata: (untyped conn) -> { host: String?, port: String?, database: String? }?

          def self.set_metadata_tags: (untyped span, { host: String?, port: String?, database: String? } metadata, ?bool set_peer_service) -> untyped

          def self.database_from_path: (String? path) -> String?

          def self.database_from_properties: (String? properties) -> String?

          def self.datadog_configuration: () -> untyped

          def self.analytics_enabled?: () -> untyped

          def self.analytics_sample_rate: () -> untyped
        end
      end
    end
  end
end
