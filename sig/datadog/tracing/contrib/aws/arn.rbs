module Datadog
  module Tracing
    module Contrib
      module Aws
        class Arn
          PREFIX: String

          SEGMENT_COUNT: Integer

          PARTITION_FORMAT: Regexp

          REGION_FORMAT: Regexp

          ACCOUNT_ID_FORMAT: Regexp

          attr_reader partition: String

          attr_reader service: String

          attr_reader region: String?

          attr_reader account_id: String?

          attr_reader resource: String

          def self.scannable?: (any value) -> bool

          def self.arn_like?: (any value) -> bool

          def self.parse: (any value) -> Arn?

          def initialize: (
            partition: String,
            service: String,
            region: String?,
            account_id: String?,
            resource: String
          ) -> void

          def resource_name: (String service_name, Regexp format) -> String?
        end
      end
    end
  end
end
