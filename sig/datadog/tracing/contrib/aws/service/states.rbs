module Datadog
  module Tracing
    module Contrib
      module Aws
        module Service
          class States < Base
            SERVICE: String

            STATE_MACHINE_RESOURCE_TYPES: Array[String]

            EXECUTION_RESOURCE_TYPES: Array[String]

            def add_tags: (Datadog::Tracing::SpanOperation span, Hash[Symbol, any] params) -> void

            private

            def parse_state_machine: (any execution_arn, any state_machine_arn) -> [String, String?]?
          end
        end
      end
    end
  end
end
