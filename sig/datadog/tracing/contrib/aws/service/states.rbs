module Datadog
  module Tracing
    module Contrib
      module Aws
        module Service
          class States < Base
            SERVICE: ::String

            STATE_MACHINE_RESOURCE_TYPES: ::Array[::String]

            EXECUTION_RESOURCE_TYPES: ::Array[::String]

            def add_tags: (untyped span, untyped params) -> untyped

            private

            def parse_state_machine: (untyped execution_arn, untyped state_machine_arn) -> [::String, ::String?]?

            def target_identity: (Arn arn, ::String name) -> ::Array[::String?]
          end
        end
      end
    end
  end
end
