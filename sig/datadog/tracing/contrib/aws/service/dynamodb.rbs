module Datadog
  module Tracing
    module Contrib
      module Aws
        module Service
          class DynamoDB < Base
            SERVICE: ::String

            TABLE_RESOURCE_TYPES: ::Array[::String]

            TABLE_RESOURCE_SEGMENTS: ::Integer

            def add_tags: (untyped span, untyped params) -> untyped

