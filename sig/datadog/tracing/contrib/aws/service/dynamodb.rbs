module Datadog
  module Tracing
    module Contrib
      module Aws
        module Service
          class DynamoDB < Base
            ENDPOINT_LABEL: ::Regexp

            BARE_TABLE_NAME_FORMAT: ::Regexp

            def add_tags: (untyped span, untyped params) -> untyped

            def add_owner_tags: (Datadog::Tracing::SpanOperation span, any params, Contrib::Aws::ParsedContext context) -> void
          end
        end
      end
    end
  end
end
