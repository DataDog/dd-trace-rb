module Datadog
  module Tracing
    module Workers
      class AsyncTransport
        DEFAULT_BUFFER_MAX_SIZE: 1000

        DEFAULT_FLUSH_INTERVAL: 1

        DEFAULT_TIMEOUT: 5

        BACK_OFF_RATIO: ::Float

        BACK_OFF_MAX: 5

        DEFAULT_SHUTDOWN_TIMEOUT: 1

        @transport: untyped

        @trace_task: (^(::Array[TraceSegment] traces, untyped transport) -> bool)?

        @flush_interval: ::Integer | ::Float

        @back_off: ::Integer | ::Float

        @shutdown: ::Thread::ConditionVariable

        @shutdown_timeout: ::Integer | ::Float

        @mutex: ::Thread::Mutex

        @worker: ::Thread?

        @run: bool

        @logger: Core::Logger

        attr_reader trace_buffer: CRubyTraceBuffer | ThreadSafeTraceBuffer

        attr_reader logger: Core::Logger

        def initialize: (?::Hash[::Symbol, untyped] options) -> void

        def callback_traces: () -> bool?

        def start: () -> nil

        def stop: () -> true?

        def join: () -> ::Thread?

        def enqueue_trace: (TraceSegment? trace) -> void

        private

        alias flush_data callback_traces

        def perform: () -> void
      end
    end
  end
end
