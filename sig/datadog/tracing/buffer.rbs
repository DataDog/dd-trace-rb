module Datadog
  module Tracing
    module MeasuredBuffer
      @buffer_accepted: ::Integer

      @buffer_accepted_lengths: ::Integer

      @buffer_dropped: ::Integer

      @buffer_spans: ::Integer

      @max_size: ::Integer

      def initialize: (*untyped _) -> void

      def add!: (TraceSegment trace) -> void

      def add_all!: (::Array[TraceSegment] traces) -> void

      def replace!: (TraceSegment trace) -> TraceSegment?

      def drain!: () -> ::Array[TraceSegment]

      def measure_accept: (TraceSegment trace) -> void

      def measure_drop: (TraceSegment trace) -> void

      def measure_pop: (::Array[TraceSegment] traces) -> void
    end

    class ThreadSafeTraceBuffer < Core::Buffer::ThreadSafe
      prepend MeasuredBuffer
    end

    class CRubyTraceBuffer < Core::Buffer::CRuby
      prepend MeasuredBuffer
    end

    TraceBuffer: singleton(CRubyTraceBuffer) | singleton(ThreadSafeTraceBuffer)
  end
end
