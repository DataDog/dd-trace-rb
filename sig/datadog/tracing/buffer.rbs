module Datadog
  module Tracing
    module MeasuredBuffer
      @buffer_accepted: ::Integer
      @buffer_accepted_lengths: ::Integer
      @buffer_dropped: ::Integer
      @buffer_spans: ::Integer
      # Provided by the host buffer class (Core::Buffer::Random).
      @max_size: ::Integer

      def initialize: (*untyped _) -> void

      def add!: (untyped trace) -> untyped

      def add_all!: (untyped traces) -> untyped

      def replace!: (untyped trace) -> untyped
      def drain!: () -> untyped

      def measure_accept: (untyped trace) -> void

      def measure_drop: (untyped trace) -> void

      def measure_pop: (untyped traces) -> void
    end
    class ThreadSafeTraceBuffer < Core::Buffer::ThreadSafe
      prepend MeasuredBuffer
    end
    class CRubyTraceBuffer < Core::Buffer::CRuby
      prepend MeasuredBuffer
    end
    TraceBuffer: untyped
  end
end
