module Datadog
  module Tracing
    class TraceOperation
      include Metadata::Tagging

      DEFAULT_MAX_LENGTH: ::Integer
      AUTO_SAMPLING_PRIORITIES: ::Array[::Integer]
      RECONSIDERABLE_DECISIONS: ::Array[::String]

      @logger: Core::Logger
      @span_links: ::Array[SpanLink]?
      @distributed_sampling_priority: bool

      @profiling_enabled: bool?

      @apm_tracing_enabled: bool?

      @finished: bool

      @spans: Array[Span]

      @auto_finish: bool

      @flushed: bool

      @propagated: bool

      attr_reader logger: Core::Logger

      attr_accessor agent_sample_rate: untyped
      attr_accessor hostname: untyped
      attr_accessor origin: untyped
      attr_accessor rate_limiter_rate: untyped
      attr_accessor rule_sample_rate: untyped
      attr_accessor sample_rate: untyped
      attr_accessor remote_parent: untyped
      attr_accessor sampling_priority: untyped
      attr_accessor baggage: untyped
      attr_reader active_span_count: untyped
      attr_reader active_span: untyped
      attr_reader id: untyped
      attr_reader max_length: untyped
      attr_reader parent_span_id: untyped
      attr_reader trace_state: Distributed::TraceState
      attr_writer name: untyped
      attr_writer resource: untyped
      attr_writer sampled: untyped
      attr_writer service: untyped

      def initialize: (
        ?logger: untyped,
        ?agent_sample_rate: untyped?,
        ?events: untyped?,
        ?hostname: untyped?,
        ?id: untyped?,
        ?max_length: untyped,
        ?name: untyped?,
        ?origin: untyped?,
        ?parent_span_id: untyped?,
        ?span_links: ::Array[SpanLink]?,
        ?rate_limiter_rate: untyped?,
        ?resource: untyped?,
        ?rule_sample_rate: untyped?,
        ?sample_rate: untyped?,
        ?sampled: untyped?,
        ?sampling_priority: untyped?,
        ?service: untyped?,
        ?profiling_enabled: untyped?,
        ?apm_tracing_enabled: untyped?,
        ?tags: untyped?,
        ?metrics: untyped?,
        ?trace_state: Distributed::TraceState?,
        ?remote_parent: untyped?,
        ?distributed_sampling_priority: bool,
        ?tracer: untyped?,
        ?baggage: untyped?,
        ?auto_finish: bool
      ) -> void

      def finish!: -> void

      def full?: () -> untyped
      def finished_span_count: () -> untyped
      def finished?: () -> untyped
      def sampled?: () -> bool
      def priority_sampled?: () -> bool
      def keep!: () -> untyped
      def reject!: () -> untyped
      def name: () -> untyped
      def resource: () -> untyped
      def set_distributed_source: (Integer product_bit) -> void
      def resource_override?: () -> bool
      def reconsider_resource_sample?: () -> bool
      def service: () -> untyped
      def measure: [T] (String op_name, ?logger: Core::Logger, ?events: SpanOperation::Events?, ?on_error: on_error?, ?resource: String?, ?service: String?, ?start_time: Time?, ?tags: Hash[String, untyped]?, ?type: String?, ?id: Integer?) { (SpanOperation span_op, TraceOperation trace_op) -> T } -> T
      def build_span: (String op_name, ?logger: Core::Logger, ?events: SpanOperation::Events?, ?on_error: on_error?, ?resource: String?, ?service: String?, ?start_time: Time?, ?tags: Hash[String, untyped]?, ?type: String?, ?id: Integer?) -> SpanOperation
      def flush!: () ?{ (Array[Span]) -> Array[Span] } -> TraceSegment
      def to_digest: () -> TraceDigest
      def to_correlation: () -> Correlation::Identifier
      def fork_clone: () -> TraceOperation

      class Events
        include Tracing::Events

        attr_reader span_before_finish: untyped
        attr_reader span_before_start: untyped
        attr_reader span_finished: untyped
        attr_reader trace_finished: untyped
        attr_reader trace_propagated: untyped
        attr_reader trace_resource_change: untyped

        def initialize: () -> void

        class SpanBeforeFinish < Tracing::Event
          def initialize: () -> void
        end

        class SpanBeforeStart < Tracing::Event
          def initialize: () -> void
        end

        class SpanFinished < Tracing::Event
          def initialize: () -> void
        end

        class TraceFinished < Tracing::Event
          @deactivate_trace_subscribed: bool

          def initialize: () -> void

          def deactivate_trace_subscribed?: () -> bool
          def subscribe_deactivate_trace: () { (TraceOperation trace_op) -> untyped } -> Array[^(?) -> untyped]
        end

        class TracePropagated < Tracing::Event
          def initialize: () -> void
        end

        class TraceResourceChange < Tracing::Event
          def initialize: () -> void
        end
      end

      private

      attr_reader events: untyped
      attr_reader root_span: untyped

      def activate_span!: (untyped span_op) -> untyped
      def deactivate_span!: (untyped span_op) -> untyped
      def start_span: (untyped span_op) -> untyped
      def before_finish_span: (untyped span_op) -> untyped
      def finish_span: (untyped span, untyped span_op, untyped parent) -> untyped

      def set_local_root_span!: (SpanOperation? span) -> SpanOperation?

      def build_trace: (untyped spans, ?bool partial) -> untyped
      def distributed_tags: () -> untyped

      def reconsider_rule_sample?: () -> bool

      def reset: () -> void
    end
  end
end
