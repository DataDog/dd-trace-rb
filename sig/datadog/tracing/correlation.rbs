module Datadog
  module Tracing
    module Correlation
      class Identifier
        @env: String?

        @service: String

        @span_id: Integer

        @trace_id: Integer

        @version: String

        @to_h: untyped

        @log_format: untyped

        LOG_ATTR_ENV: "dd.env"

        LOG_ATTR_SERVICE: "dd.service"

        LOG_ATTR_SPAN_ID: "dd.span_id"

        LOG_ATTR_TRACE_ID: "dd.trace_id"

        LOG_ATTR_VERSION: "dd.version"

        LOG_ATTR_SOURCE: "ddsource"

        attr_reader env: String?

        attr_reader service: String

        attr_reader version: String
        def initialize: (?env: untyped?, ?service: untyped?, ?span_id: Integer?, ?trace_id: Integer?, ?version: untyped?) -> void

        def to_h: () -> untyped
        def to_log_format: () -> untyped

        def span_id: () -> String

        def trace_id: () -> String
      end
      def self?.identifier_from_digest: (TraceDigest? digest) -> Identifier

      def self?.format_trace_id: (::Integer trace_id) -> ::String

      def self?.format_trace_id_128: (::Integer trace_id) -> ::String
    end
  end
end
