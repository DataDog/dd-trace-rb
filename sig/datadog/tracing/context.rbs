module Datadog
  module Tracing
    class Context
      include Core::Utils::Forking

      attr_reader active_trace: TraceOperation?

      attr_writer otel_thread_context: OTelThreadContext?

      def initialize: (?trace: TraceOperation?, ?otel_thread_context: OTelThreadContext?) -> void

      def activate!: [T] (TraceOperation? trace) { () -> T } -> T
                   | (TraceOperation? trace) -> TraceOperation?

      def fork_clone: () -> Context

      private

      def set_active_trace!: (TraceOperation? trace) -> TraceOperation?
    end
  end
end
