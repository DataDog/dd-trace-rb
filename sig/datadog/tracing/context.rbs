module Datadog
  module Tracing
    class Context
      include Core::Utils::Forking

      attr_reader active_trace: untyped
      attr_writer otel_thread_context: OTelThreadContext?

      def initialize: (?trace: untyped?, ?otel_thread_context: OTelThreadContext?) -> void
      def activate!: (untyped trace) { () -> untyped } -> untyped
      def fork_clone: () -> untyped

      private

      def set_active_trace!: (untyped trace) -> untyped
    end
  end
end
