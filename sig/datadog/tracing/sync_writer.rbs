module Datadog
  module Tracing
    class SyncWriter
      @logger: Core::Logger

      @agent_settings: Core::Configuration::AgentSettings?

      @transport: untyped

      @events: Writer::Events

      attr_reader logger: Core::Logger

      attr_reader events: Writer::Events

      attr_reader transport: untyped

      attr_reader agent_settings: Core::Configuration::AgentSettings?

      def initialize: (?transport: untyped, ?transport_options: ::Hash[::Symbol, untyped], ?agent_settings: Core::Configuration::AgentSettings?, ?logger: Core::Logger) -> void

      def write: (TraceSegment trace) -> untyped

      def stop: () -> true

      private

      def flush_trace: (TraceSegment trace) -> untyped
    end
  end
end
