module Datadog
  module Tracing
    class Writer
      @logger: Datadog::Core::Logger
      @buff_size: ::Integer
      @flush_interval: ::Numeric
      @agent_settings: untyped?
      # Transport is duck-typed: callers pass custom transports responding to
      # #send_traces, #stats, and optionally #close, so it stays untyped.
      @transport: untyped
      @shutdown_timeout: ::Numeric
      @mutex_after_fork: ::Mutex
      @pid: ::Integer?
      @traces_flushed: ::Integer
      @worker: Workers::AsyncTransport?
      @stopped: bool
      @events: Events
      @trace_handler: (^(untyped, untyped) -> bool)?

      attr_reader logger: Datadog::Core::Logger

      attr_reader transport: untyped

      attr_reader worker: Workers::AsyncTransport?

      attr_reader events: Events

      attr_reader agent_settings: untyped?

      def initialize: (?::Hash[untyped, untyped] options) -> void

      public

      def start: () -> bool?
      def stop: () -> (nil | true)

      def send_spans: (untyped traces, untyped transport) -> bool
      def write: (untyped trace) -> untyped
      def stats: () -> { traces_flushed: ::Integer, transport: untyped }

      private

      def start_worker: () -> untyped
      def stop_worker: () -> (nil | true)
      def reset_stats!: () -> void

      class Events
        attr_reader after_send: AfterSend

        def initialize: () -> void

        class AfterSend < Tracing::Event
          def initialize: () -> void
        end
      end
    end
  end
end
