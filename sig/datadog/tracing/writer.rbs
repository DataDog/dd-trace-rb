module Datadog
  module Tracing
    class Writer
      @logger: Core::Logger

      @buff_size: ::Integer

      @flush_interval: ::Integer | ::Float

      @agent_settings: Core::Configuration::AgentSettings?

      @transport: untyped

      @shutdown_timeout: ::Integer | ::Float

      @mutex_after_fork: ::Thread::Mutex

      @pid: ::Integer?

      @traces_flushed: ::Integer

      @worker: Workers::AsyncTransport?

      @stopped: bool

      @events: Events

      @trace_handler: ^(::Array[TraceSegment] items, untyped transport) -> bool

      attr_reader logger: Core::Logger

      attr_reader transport: untyped

      attr_reader worker: Workers::AsyncTransport?

      attr_reader events: Events

      attr_reader agent_settings: Core::Configuration::AgentSettings?

      def initialize: (?::Hash[::Symbol, untyped] options) -> void

      def start: () -> bool?

      def stop: () -> true

      def send_spans: (::Array[TraceSegment] traces, untyped transport) -> bool

      def write: (TraceSegment trace) -> void

      def stats: () -> { traces_flushed: ::Integer, transport: untyped }

      class Events
        attr_reader after_send: AfterSend

        def initialize: () -> void

        class AfterSend < Tracing::Event
          def initialize: () -> void
        end
      end

      private

      def start_worker: () -> nil

      def stop_worker: () -> true

      def reset_stats!: () -> untyped
    end
  end
end
