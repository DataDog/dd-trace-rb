module Datadog
  module Tracing
    module Distributed
      class B3Single
        B3_SINGLE_HEADER_KEY: "b3"

        @key: ::String
        @fetcher: singleton(Distributed::Fetcher)

        def initialize: (fetcher: untyped, ?key: untyped) -> void

        def inject!: (TraceDigest? digest, untyped env) -> (nil | untyped)

        def extract: (untyped env) -> TraceDigest?
      end
    end
  end
end
