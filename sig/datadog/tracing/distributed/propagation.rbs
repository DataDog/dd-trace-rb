module Datadog
  module Tracing
    module Distributed
      interface _Propagator
        def inject!: (TraceDigest? digest, untyped data) -> untyped
        def extract: (untyped data) -> TraceDigest?
      end

      class Propagation
        @propagation_styles: ::Hash[::String, _Propagator & ::Object]
        @propagation_behavior_extract: ::String
        @propagation_extract_first: bool
        @propagation_style_inject: ::Array[_Propagator & ::Object]
        @propagation_style_extract: ::Array[_Propagator & ::Object]
        @baggage_propagator: (_Propagator & ::Object)?

        def initialize: (
          propagation_styles: ::Hash[::String, _Propagator & ::Object],
          propagation_style_inject: ::Array[::String],
          propagation_style_extract: ::Array[::String],
          propagation_extract_first: bool,
          propagation_behavior_extract: String
        ) -> void
        def inject!: ((TraceDigest | TraceOperation)? digest, Hash[untyped, untyped] data) -> (bool | nil)
        def extract: (Hash[untyped, untyped] data) -> TraceDigest?

        private

        def propagate_baggage: (untyped data, TraceDigest? extracted_trace_digest) -> TraceDigest?

        def last_datadog_parent_id: (untyped headers, Hash[String, String]? tracecontext_tags) -> String?
      end
    end
  end
end
