module Datadog
  module Tracing
    class Tracer
      @logger: Core::Logger

      @otel_thread_context: OTelThreadContext?

      @trace_completed: untyped

      @profiling_enabled: bool?

      @appsec_enabled: bool

      @ai_guard_enabled: bool

      @apm_tracing_enabled: bool

      attr_reader logger: Core::Logger

      attr_reader trace_flush: untyped

      attr_reader provider: untyped

      attr_reader sampler: untyped

      attr_reader span_sampler: untyped

      attr_reader tags: Hash[String, untyped]

      attr_accessor default_service: untyped

      attr_accessor enabled: untyped

      attr_accessor writer: untyped

      def initialize: (
        ?trace_flush: untyped trace_flush,
        ?context_provider: untyped? context_provider,
        ?default_service: untyped default_service,
        ?enabled: untyped enabled,
        ?logger: Core::Logger logger,
        ?otel_thread_context: untyped? otel_thread_context,
        ?sampler: untyped sampler,
        ?span_sampler: untyped span_sampler,
        ?tags: Hash[untyped, untyped] tags,
        writer: untyped writer
      ) -> void

      def trace: (
        untyped name,
        ?continue_from: untyped? continue_from,
        ?on_error: on_error? on_error,
        ?resource: untyped? resource,
        ?service: untyped? service,
        ?start_time: untyped? start_time,
        ?tags: untyped? tags,
        ?type: untyped? type,
        ?id: untyped? id
      ) ?{ (untyped span_op, ?untyped trace_op) -> untyped } -> untyped

      def set_tags: (Hash[untyped, untyped] tags) -> void

      def active_trace: (?untyped? key) -> untyped

      def active_span: (?untyped? key) -> Datadog::Tracing::SpanOperation

      def active_correlation: (?untyped? key) -> Correlation::Identifier

      def continue_trace!: (untyped digest, ?untyped? key) ?{ () -> untyped } -> untyped

      def sample_trace: (untyped trace_op) -> void

      def reconsider_trace_sampling_on_resource: (untyped trace_op) -> void

      # @!visibility private
      def trace_completed: () -> TraceCompleted

      def after_fork: () -> void

      def shutdown!: () -> void

      def propagate_sampling_priority?: (upstream_tags: Hash[String, String]) -> bool

      def appsec_enabled: () -> bool

      def ai_guard_enabled: () -> bool

      def apm_tracing_enabled: () -> bool

      private

      def call_context: (?untyped? key) -> untyped

      def build_trace: (untyped digest, bool auto_finish) -> untyped

      def bind_trace_events!: (untyped trace_op) -> void

      def start_trace: (?continue_from: untyped? continue_from, ?auto_finish: bool auto_finish) -> untyped

      def start_span: (
        untyped name,
        ?continue_from: untyped? continue_from,
        ?on_error: on_error? on_error,
        ?resource: untyped? resource,
        ?service: untyped? service,
        ?start_time: untyped? start_time,
        ?tags: untyped? tags,
        ?type: untyped? type,
        ?_trace: untyped? _trace,
        ?id: untyped? id
      ) ?{ (untyped) -> untyped } -> untyped

      def resolve_tags: (untyped? tags, untyped? service) -> untyped

      def manual_trace_activation!: (untyped context, untyped trace) -> void

      def subscribe_trace_deactivation!: (untyped context, untyped trace, untyped original_trace) -> void

      def sample_span: (untyped trace_op, untyped span) -> void

      def flush_trace: (untyped trace_op) -> void

      def write: (untyped trace) -> void

      def skip_trace: (untyped name) ?{ (SpanOperation span_op, TraceOperation trace) -> untyped } -> untyped

      def profiling_enabled: () -> bool

      SAMPLE_TRACE_LOG_ONLY_ONCE: Core::Utils::OnlyOnce

      RECONSIDER_RESOURCE_SAMPLE_TRACE_LOG_ONLY_ONCE: Core::Utils::OnlyOnce

      SAMPLE_SPAN_LOG_ONLY_ONCE: Core::Utils::OnlyOnce

      FLUSH_TRACE_LOG_ONLY_ONCE: Core::Utils::OnlyOnce

      # Triggered whenever a trace is completed
      class TraceCompleted < Tracing::Event
        def initialize: () -> void

        def publish: (untyped trace) -> untyped
      end
    end
  end
end
