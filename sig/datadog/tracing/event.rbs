module Datadog
  module Tracing
    module Events
      interface _EventsClass
        def new: () -> InstanceMethods
      end

      interface _WithEvents
        def events: () -> untyped
      end

      def self.included: (Module base) -> void

      module ClassMethods : _EventsClass
        def build: (**untyped event_handlers) -> InstanceMethods
      end

      module InstanceMethods : _WithEvents
        def subscribe: (**Hash[Symbol, ^(*untyped) -> untyped] event_handlers) -> Hash[Symbol, Hash[Symbol, ^(*untyped) -> untyped]]?
      end
    end

    class Event
      attr_reader name: Symbol

      attr_reader subscriptions: Array[^(?) -> untyped]

      def initialize: (Symbol name) -> void

      def subscribe: () { (?) -> untyped } -> Array[^(?) -> untyped]

      def unsubscribe_all!: () -> true

      def publish: (*untyped args) -> true
    end
  end
end
