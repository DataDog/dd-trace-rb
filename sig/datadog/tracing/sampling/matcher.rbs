module Datadog
  module Tracing
    module Sampling
      class Matcher
        MATCH_ALL_PATTERN: String

        interface _Matcher
          def match?: (::String) -> bool
        end

        type matcher = _Matcher & Object

        MATCH_ALL: matcher

        def self.glob_to_regex: (::String) -> matcher

        def match?: (TraceOperation trace) -> bool
      end

      class SimpleMatcher < Matcher
        attr_reader name: Matcher::matcher

        attr_reader service: Matcher::matcher

        attr_reader resource: Matcher::matcher

        attr_reader tags: ::Hash[::String, Matcher::matcher]

        def initialize: (?name: ::String, ?service: ::String, ?resource: ::String, ?tags: ::Hash[::String, ::String]) -> void

        def match?: (TraceOperation trace) -> bool

        private

        def tags_match?: (TraceOperation trace) -> bool
      end
    end
  end
end
