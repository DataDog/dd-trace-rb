module Datadog
  module Tracing
    module Sampling
      module Span
        class Rule
          @sampler: Sampling::RateSampler

          @rate_limiter: Core::TokenBucket

          attr_reader matcher: Matcher

          attr_reader sample_rate: ::Float | ::Integer

          attr_reader rate_limit: ::Float | ::Integer

          def initialize: (Matcher matcher, ?sample_rate: ::Float | ::Integer, ?rate_limit: ::Float | ::Integer) -> void

          def sample!: (TraceOperation trace_op, SpanOperation span_op) -> (:kept | :rejected | :not_matched)

          def ==: (untyped other) -> bool
        end
      end
    end
  end
end
