module Datadog
  module Tracing
    module Sampling
      class RateByServiceSampler < RateByKeySampler
        DEFAULT_KEY: "service:,env:"

        @env: (::String | ^() -> ::String?)?

        def initialize: (?::Float default_rate, ?env: (::String | ^() -> ::String?)?, ?decision: ::String) -> void

        def update: (::Hash[::String, ::Float] rate_by_service, ?decision: ::String?) -> untyped

        private

        def key_for: (TraceOperation trace) -> ::String
      end
    end
  end
end
