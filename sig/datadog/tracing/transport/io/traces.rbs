module Datadog
  module Tracing
    module Transport
      module IO
        module Traces
          class Response < IO::Response
            @trace_count: untyped

            include Transport::Traces::Response

            def initialize: (untyped result, ?Integer trace_count) -> void
          end
          module Client
            include Encoder
            interface _IOClientHost
              def send_request: (untyped request) ?{ (untyped out, untyped request) -> untyped } -> untyped

              def write_data: (untyped out, untyped data) -> untyped
            end
            include _IOClientHost

            def send_traces: (untyped traces) ?{ (untyped, untyped) -> untyped } -> Array[untyped]
          end
          module Encoder
            ENCODED_IDS: Array[:trace_id | :span_id | :parent_id]
            def encode_traces: (untyped traces) -> untyped

            private

            def encode_trace: (untyped trace) -> untyped
          end
        end
      end
    end
  end
end
