module Datadog
  module Tracing
    module Transport
      module IO
        module Traces
          class Response < IO::Response
            @trace_count: ::Integer

            include Transport::Traces::Response

            def initialize: (untyped result, ?::Integer trace_count) -> void
          end

          module Client : IO::Client
            include Encoder

            def send_traces: (::Array[TraceSegment] traces) ?{ (untyped out, ::String data) -> untyped } -> ::Array[untyped]
          end

          module Encoder
            ENCODED_IDS: ::Array[::Symbol]

            def encode_traces: (::Array[TraceSegment] traces) -> { traces: ::Array[::Array[::Hash[::Symbol, untyped]]] }

            private

            def encode_trace: (TraceSegment trace) -> ::Array[::Hash[::Symbol, untyped]]
          end
        end
      end
    end
  end
end
