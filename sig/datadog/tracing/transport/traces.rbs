module Datadog
  module Tracing
    module Transport
      module Traces
        class Parcel < Core::Transport::Parcel
          @trace_count: Integer

          attr_reader trace_count: Integer

          def initialize: (String data, trace_count: Integer, **untyped) -> void
        end
        class Request < Datadog::Core::Transport::Request
          @http_status: Integer?

          @capture_telemetry: bool

          attr_reader http_status: Integer?

          attr_writer capture_telemetry: bool

          def initialize: (?Core::Transport::Parcel? parcel) -> void

          def capture_status: (untyped response) -> void
        end
        module Response
          attr_reader service_rates: untyped

          attr_reader trace_count: untyped
        end
        class Chunker
          @encoder: untyped

          @logger: untyped

          @native_events_supported: bool

          @max_size: untyped

          @telemetry: HTTP::Telemetry::Batch?
          DEFAULT_MAX_PAYLOAD_SIZE: untyped

          attr_reader encoder: untyped

          attr_reader max_size: untyped

          attr_reader logger: untyped
          def initialize: (untyped encoder, logger: untyped, native_events_supported: untyped, ?max_size: untyped, ?telemetry: HTTP::Telemetry::Batch?) -> void
          def encode_in_chunks: (untyped traces) -> untyped

          private

          def encode_one: (untyped trace) -> (nil | untyped)
        end
        module Encoder
          def self?.encode_trace: (untyped encoder, untyped trace, logger: untyped, native_events_supported: untyped) -> untyped
        end
        class Transport < Core::Transport::Transport
          include SpanEventsNegotiation

          @telemetry: HTTP::Telemetry?

          def initialize: (Core::Transport::HTTP::API::Map apis, String default_api, logger: Core::Logger) -> void

          def telemetry=: (Core::Telemetry::Component client) -> void

          def send_traces: (Array[Tracing::TraceSegment] traces) -> untyped

          def stats: () -> untyped
	  
          # Traces transport overrides HTTP client
          # Instance variable type replacement is not permitted by steep.
          #@client: Tracing::Transport::HTTP::Client
          def client: () -> Tracing::Transport::HTTP::Client

        end
      end
    end
  end
end
