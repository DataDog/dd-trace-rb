module Datadog
  module OpenTelemetry
    module SDK
      module Configurator
        @id_generator: singleton(IdGenerator)

        @propagators: Array[Propagator]

        @datadog_logs_hook_called: bool

        def initialize: () -> void

        def configure_propagation: () -> void

        def wrapped_exporters_from_env: () -> Array[SpanProcessor]

        def configure: () -> void

        def metrics_configuration_hook: () -> void

        def logs_configuration_hook: () -> void
      end
    end
  end
end
