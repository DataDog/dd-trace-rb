module Datadog
  module OpenTelemetry
    module SDK
      class Propagator
        @datadog_propagator: singleton(Tracing::Contrib::HTTP)

        def initialize: (singleton(Tracing::Contrib::HTTP) datadog_propagator) -> void

        def inject: (Hash[untyped, untyped] carrier, ?context: ::OpenTelemetry::Context, ?setter: untyped) -> void

        def extract: (Hash[untyped, untyped] carrier, ?context: ::OpenTelemetry::Context, ?getter: untyped) -> ::OpenTelemetry::Context

        def fields: () -> Array[String]
      end
    end
  end
end
