module Datadog
  module OpenTelemetry
    module Trace
      module Span
        DATADOG_SPAN_ATTRIBUTE_OVERRIDES: Array[String]

        @attributes: ::OpenTelemetry::Trace::attributes?

        def set_attribute: (String key, ::OpenTelemetry::Trace::attribute_value value) -> self

        def record_exception: (Exception exception, ?attributes: ::OpenTelemetry::Trace::attributes?) -> void

        alias []= set_attribute

        def add_attributes: (::OpenTelemetry::Trace::attributes attributes) -> self

        def status=: (::OpenTelemetry::Trace::Status s) -> void

        def self.enrich_name: (Symbol kind, ::OpenTelemetry::Trace::attributes attrs) -> String

        private

        def datadog_set_attribute: (String key) -> void

        def override_datadog_values: (Tracing::SpanOperation span, String key, untyped value) -> void
      end
    end
  end
end
